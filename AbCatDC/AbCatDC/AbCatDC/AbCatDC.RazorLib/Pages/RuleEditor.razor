@page "/rules"
@using AbCatDC.Kernel
@using System.Text.Json
@inject IJSRuntime JS
@inject IServiceProvider Services
@inject NavigationManager Nav

<div class="ab-hero">
    <h1><i class="fa-solid fa-scale-balanced"></i> Inference Rule Editor</h1>
    <p>
        Design a formal system: name it, then add <em>Introduction</em>, <em>Elimination</em>,
        <em>Construction</em>, and <em>Computational</em> rules. Every premise and conclusion is
        parsed by the kernel — undeclared symbols get their ℤ-related default readings, shown with
        the canonical form in the analysis panel.
    </p>
</div>

<div class="ab-card">
    <div class="ab-sys-row">
        <div>
            <label class="ab-setting-label" for="sysname">Formal system name</label>
            <input id="sysname" class="ab-text-input" value="@systemName" @oninput="OnSystemName"
                   placeholder="e.g. Diagram-chasing arithmetic" />
        </div>
        <div>
            <label class="ab-setting-label" for="sysconsts" title="Names listed here parse as constants — never metavariables — and are function-like: Mod R applies Mod to R.">
                Rigid constants <span class="ab-muted" style="font-weight:400">— never metavariables; function-like (Mod R)</span>
            </label>
            <input id="sysconsts" class="ab-text-input" value="@constantsInput" @onchange="OnConstantsChanged"
                   placeholder="e.g. Ring Mod Grp — space-separated" />
        </div>
        <div class="ab-sem-toggle" title="[D] commutes ≡ ∀ unbound labels . ∃ dashed arrows . the diagram commutes — diagrams match by shape, contribute their typings and equations, and a dashed arrow is a witness drawn into the proof. Off = the opaque, name-matched token of older systems.">
            <label class="ab-setting-label">
                <input type="checkbox" checked="@(semanticsVersion >= 2)" @onchange="OnSemanticsToggle" />
                Diagram semantics (∀∃)
            </label>
        </div>
    </div>
</div>

<div class="ab-rule-editor-grid">
    <div class="ab-card ab-builder">
        <div class="ab-builder-head">
            <h5><i class="fa-solid @(editingRule is null ? "fa-plus" : "fa-pen")"></i> @(editingRule is null ? "New rule" : "Edit rule")</h5>
            <select class="ab-text-input ab-kind-select" value="@kind"
                    @onchange='e => kind = e.Value?.ToString() ?? "Introduction"'>
                @foreach (var k in Kinds)
                {
                    <option value="@k">@k</option>
                }
            </select>
            @if (!nameEditing)
            {
                <span class="ab-xedit" title="Click to edit the rule name" @onclick="() => nameEditing = true">
                    <span class="ab-xedit-text @(string.IsNullOrWhiteSpace(ruleName) ? "empty" : "")">@(string.IsNullOrWhiteSpace(ruleName) ? "unnamed rule" : ruleName)</span>
                    <i class="fa-solid fa-pencil ab-xedit-pen"></i>
                </span>
            }
            else
            {
                <span class="ab-xedit-editing">
                    <SymbolEditor Id="rule-name-editor" Rows="1" ShowPad="false" SubmitOnEnter="true"
                                  Placeholder="rule name — e.g. ×-intro (try \times)"
                                  Value="@ruleName" ValueChanged="v => ruleName = v"
                                  OnSubmit="_ => nameEditing = false" />
                    <button type="button" class="ab-kind-btn" title="Done (Ctrl+Enter)"
                            @onclick="() => nameEditing = false"><i class="fa-solid fa-check"></i></button>
                </span>
            }
            @if (editingRule is not null)
            {
                <button type="button" class="ab-kind-btn ab-builder-cancel" @onclick="CancelEdit">Cancel edit</button>
            }
        </div>

        <div class="ab-tabs-group">
            @* premises above the rule, conclusions below — drag a pill within
               its row to reorder, or across the rule to change its side *@
            <div class="ab-tabs-row prem @(dragIdx >= 0 ? "ab-drop-open" : "")" @ondragover:preventDefault @ondrop="() => Drop(true, premises.Count)">
                <span class="ab-tabs-label">Premises</span>
                @for (var i = 0; i < premises.Count; i++)
                {
                    var idx = i;
                    <button type="button" draggable="true"
                            class="ab-tab prem @(activeIsPremise && activeIdx == idx ? "active" : "") @DragClass(true, idx)"
                            title="@premises[idx].Raw — drag to reorder, or below the line to make it a conclusion"
                            @onclick="() => SelectTab(true, idx)"
                            @ondragstart="() => DragStart(true, idx)" @ondragenter="() => DragEnter(true, idx)"
                            @ondragover:preventDefault @ondragend="DragEnd" @ondrop="() => Drop(true, idx)">
                        <RefText Text='@TabLabel(premises[idx], "P", idx)' Sketches="SketchMap" OnEdit="EditSketchByName" />
                        <span class="ab-tab-dot @(premises[idx].Result.Success ? "ok" : "bad")"></span>
                        @if (activeIsPremise && activeIdx == idx)
                        {
                            <span class="ab-tab-x" title="Delete premise"
                                  @onclick='() => AskDelete("premise", idx, premises[idx].Raw)' @onclick:stopPropagation>×</span>
                        }
                    </button>
                }
                <button type="button" class="ab-tab add prem" title="New premise" @onclick="() => NewTab(true)">+</button>
                @if (premises.Count == 0)
                {
                    <span class="ab-muted ab-tabs-hint">no premises — this rule is an axiom</span>
                }
            </div>

            <div class="ab-tabs-rule"></div>

            <div class="ab-tabs-row concl @(dragIdx >= 0 ? "ab-drop-open" : "")" @ondragover:preventDefault @ondrop="() => Drop(false, conclusions.Count)">
                <span class="ab-tabs-label">Conclusions</span>
                @for (var i = 0; i < conclusions.Count; i++)
                {
                    var idx = i;
                    <button type="button" draggable="true"
                            class="ab-tab concl @(!activeIsPremise && activeIdx == idx ? "active" : "") @DragClass(false, idx)"
                            title="@conclusions[idx].Raw — drag to reorder, or above the line to make it a premise"
                            @onclick="() => SelectTab(false, idx)"
                            @ondragstart="() => DragStart(false, idx)" @ondragenter="() => DragEnter(false, idx)"
                            @ondragover:preventDefault @ondragend="DragEnd" @ondrop="() => Drop(false, idx)">
                        <RefText Text='@TabLabel(conclusions[idx], "C", idx)' Sketches="SketchMap" OnEdit="EditSketchByName" />
                        <span class="ab-tab-dot @(conclusions[idx].Result.Success ? "ok" : "bad")"></span>
                        @if (!activeIsPremise && activeIdx == idx)
                        {
                            <span class="ab-tab-x" title="Delete conclusion"
                                  @onclick='() => AskDelete("conclusion", idx, conclusions[idx].Raw)' @onclick:stopPropagation>×</span>
                        }
                    </button>
                }
                <button type="button" class="ab-tab add concl" title="New conclusion" @onclick="() => NewTab(false)">+</button>
            </div>
        </div>

        @if (dragError is not null)
        {
            <div class="ab-order-warn bad">
                <i class="fa-solid fa-ban"></i> @dragError
            </div>
        }
        else if (OrderWarning is { } ow)
        {
            <div class="ab-order-warn">
                <i class="fa-solid fa-triangle-exclamation"></i> @ow
                <button type="button" class="ab-kind-btn" @onclick="SortTabs">
                    <i class="fa-solid fa-arrow-down-short-wide"></i> Fix order
                </button>
            </div>
        }

        <SymbolEditor Id="tab-editor" Rows="2" ShowPad="true" PadBelow="true" SubmitOnEnter="true"
                      Placeholder="@(activeIdx < 0 ? "press + to start a premise (left) or conclusion (right)" : activeIsPremise ? $"premise P{activeIdx + 1} — Enter finishes it and opens the next" : $"conclusion C{activeIdx + 1} — Enter finishes it and opens the next")"
                      Value="@ActiveRaw" ValueChanged="OnActiveChanged" OnSubmit="OnActiveSubmit" />

        <div class="ab-builder-foot">
            <button type="button" class="ab-kind-btn" @onclick="() => OpenSketchModal(activeIsPremise)">
                <i class="fa-solid fa-plus"></i> Sketch
            </button>
            @if (ActiveTag is not null && CanToggle(ActiveTag))
            {
                <button type="button" class="ab-kind-btn" title="Expand/contract diagram ⇄ judgment group"
                        @onclick="() => ToggleActive()"><i class="fa-solid fa-right-left"></i> ⇄</button>
            }
            <button type="button" class="ab-btn-primary" @onclick="AddRule"
                    disabled="@(!conclusions.Any(t => t.Result.Success))">
                <i class="fa-solid @(editingRule is null ? "fa-circle-plus" : "fa-floppy-disk")"></i>
                @(editingRule is null ? "Add rule to system" : "Save changes")
            </button>
            @if (!conclusions.Any(t => t.Result.Success))
            {
                <span class="ab-muted">a rule needs a conclusion — use the right-hand +</span>
            }
        </div>
    </div>

    <div class="ab-card">
        <h5><i class="fa-solid fa-microscope"></i> Analysis</h5>
        @if (analysis is null)
        {
            <p class="ab-muted">Type into a premise/conclusion box — or click a tag — to see how it parses, what the ℤ-related defaults are, and its canonical form.</p>
        }
        else if (!analysis.Success)
        {
            <div class="ab-error">@analysis.Error</div>
        }
        else
        {
            <div class="ab-analysis-row"><span>Parsed</span><pre><RefText Text="@analysis.Formatted" Sketches="SketchMap" OnEdit="EditSketchByName" /></pre></div>
            @if (!string.IsNullOrEmpty(analysis.Elaborated))
            {
                <div class="ab-analysis-row"><span>Elaborated</span><pre><RefText Text="@analysis.Elaborated" Sketches="SketchMap" OnEdit="EditSketchByName" /></pre></div>
            }
            <div class="ab-analysis-row"><span>Canonical</span><pre>@analysis.Canonical</pre></div>
            @if (!string.IsNullOrEmpty(analysis.Inference))
            {
                <div class="ab-analysis-row"><span>Leaf typings</span><pre>@analysis.Inference</pre></div>
            }
            @if (semanticsVersion >= 2)
            {
                @foreach (var dm in Api.DiagramMeanings(analysis.Formatted))
                {
                    var mo = dm.Item2;
                    <div class="ab-analysis-row"><span>@dm.Item1 means</span><pre class="ab-meaning">@(mo.Prefix.Length > 0 ? mo.Prefix + "\n" : "")@(string.Join("\n", mo.Typings.Concat(mo.Equations).Concat(mo.Uniqueness)))@(mo.Notes.Length > 0 ? "\n" + string.Join("\n", mo.Notes.Select(n => "— " + n)) : "")</pre></div>
                }
            }
        }
    </div>
</div>

@if (sketches.Count > 0)
{
    <div class="ab-card">
        <h5 class="ab-pal-toggle" @onclick="() => sketchGalleryOpen = !sketchGalleryOpen">
            <i class="fa-solid fa-compass-drafting"></i> Manage sketches
            <span class="ab-muted" style="font-weight:400">— @sketches.Count sketch@(sketches.Count == 1 ? "" : "es"); rules show them inline. Open to edit or delete.</span>
            <i class="fa-solid @(sketchGalleryOpen ? "fa-chevron-up" : "fa-chevron-down") ab-pal-chev"></i>
        </h5>
        @if (sketchGalleryOpen)
        {
        <div class="ab-sketch-grid">
            @foreach (var s in sketches)
            {
                var ss = s;
                <div class="ab-sketch-item">
                    <div class="ab-sketch-head">
                        <code>[@ss.Name]</code>
                        <button type="button" class="ab-tag-x" title="Delete sketch"
                                @onclick='() => AskDelete("sketch", sketches.IndexOf(ss), ss.Name)'>×</button>
                    </div>
                    @if (!string.IsNullOrEmpty(ss.Snapshot))
                    {
                        <img class="ab-snap-card" src="@ss.Snapshot" alt="[@ss.Name]" title="click to edit" @onclick="() => OpenSketchOverlay(ss)" />
                    }
                    else
                    {
                        <button type="button" class="ab-snap-missing-card" @onclick="() => OpenSketchOverlay(ss)">
                            <i class="fa-solid fa-camera"></i> no snapshot — open the editor and take one
                        </button>
                    }
                </div>
            }
        </div>
        }
    </div>
}

<div class="ab-card">
    <label class="ab-setting-label" for="exsel"><i class="fa-solid fa-boxes-stacked"></i> Example palettes</label>
    <select id="exsel" class="ab-text-input" value="@exampleSel" @onchange="OnExampleSelected">
        <option value="">Load an example palette…</option>
        @foreach (var ex in ExampleSystems.All)
        {
            <option value="@ex.Name">@ex.Name (@ex.Rules.Length rules)</option>
        }
    </select>
</div>

<div class="ab-card">
    <div class="ab-sys-head">
        <h5><i class="fa-solid fa-book"></i> @(string.IsNullOrWhiteSpace(systemName) ? "Formal system" : systemName)
            <span class="ab-muted" style="font-weight:400">— @rules.Count rule@(rules.Count == 1 ? "" : "s"), @sketches.Count sketch@(sketches.Count == 1 ? "" : "es")</span>
        </h5>
        <div class="ab-sys-actions">
            <button type="button" class="ab-kind-btn" title="Copy the whole system as JSON" @onclick="ExportSystem">
                <i class="fa-solid @(exportCopied ? "fa-check" : "fa-copy")"></i> @(exportCopied ? "Copied!" : "Export JSON")
            </button>
            @if (rules.Count > 0 || sketches.Count > 0)
            {
                <button type="button" class="ab-kind-btn danger" title="Delete every rule and sketch"
                        @onclick='() => AskDelete("system", 0, systemName)'>
                    <i class="fa-solid fa-trash-can"></i> Clear
                </button>
            }
        </div>
    </div>
    <div class="ab-reading-note">
        <button type="button" class="ab-kind-btn" @onclick="() => readingOpen = !readingOpen">
            <i class="fa-solid fa-book-open"></i> How to read these rules
        </button>
        @if (readingOpen)
        {
            <ul class="ab-reading-list">
                <li>Premises sit <em>above</em> the line, conclusions <em>below</em>; the name is on the right.</li>
                <li><strong>Sequents</strong>: <code>Γ, x : σ ⊢ M : τ</code> — Γ, Δ, Θ, Ξ stand for whole contexts; <code>x : σ</code> adds a hypothesis, binding x to its right. Type <code>\vdash</code>, <code>\Gamma</code>.</li>
                <li><strong>Greek letters are schematic</strong>: σ, τ, … range over any type, so a rule is a template. (In <code>∀α. τ</code>, α is object-level.)</li>
                <li><strong>Composition</strong>: <code>gf</code> and <code>g ∘ f</code> (<code>\circ</code>) are one term, applied right to left. Operands are plain names — for (f + g)∘e set <code>s = f + g</code>, then <code>s ∘ e</code>.</li>
                <li><strong>Rigid names</strong>: anything in <em>Rigid constants</em>, or containing <code>_</code>, is a constant taking arguments — <code>M : Mod(R)</code>. Other letters get the ℤ-defaults (<code>a : ℕ</code>, <code>A ⊆ ℤ</code>).</li>
                <li><strong>Diagrams</strong>: <code>[D] commutes</code> means ∀ unbound labels . ∃ dashed/dotted arrows (and <code>∃X</code> objects) . every two parallel paths agree; <code>!u</code> marks a unique arrow. A diagram premise matches any proven diagram of the same shape, and <code>[D] in C</code> supplies its typings. <code>[D] has exact rows</code> (or <code>columns</code>) asserts <code>exact(f, g)</code> at every interior object of each row — label a zero arrow <code>0</code> to state exactness at the ends.</li>
                <li>Click an expression for its parse and typings; <i class="fa-solid fa-circle-info"></i> shows a rule's remark.</li>
            </ul>
        }
    </div>
    @if (rulesLoading)
    {
        <p class="ab-muted"><i class="fa-solid fa-spinner fa-spin"></i> Loading rules…</p>
    }
    else if (rules.Count == 0)
    {
        <p class="ab-muted">No rules yet — build one above.</p>
    }
    else
    {
        @foreach (var k in Kinds)
        {
            var kindRules = rules.Where(r => r.Kind == k).ToList();
            if (kindRules.Count > 0)
            {
                <h6 class="ab-rule-kind-head">@k rules <span class="ab-muted">(@kindRules.Count)</span></h6>
                <div class="ab-rule-list">
                    @foreach (var r in kindRules)
                    {
                        var rr = r;
                        <div class="ab-rule k-@rr.Kind.ToLowerInvariant() @(rr == editingRule ? "editing" : "") @(rr == highlightRule ? "highlight" : "")" id="rule-card-@rules.IndexOf(rr)">
                            <div class="ab-rule-row">
                                <div class="ab-rule-frac">
                                    <div class="ab-rule-prem">
                                        @if (rr.Premises.Count == 0)
                                        {
                                            <span class="ab-muted">(no premises)</span>
                                        }
                                        @foreach (var p in rr.Premises)
                                        {
                                            <span class="@(p.Result.Success ? "" : "ab-bad-expr")" title="@(p.Result.Success ? "" : p.Result.Error)"
                                                  @onclick="() => ShowAnalysis(p)"><InlineExpr Text="@(p.Result.Success ? p.Result.Formatted : p.Raw)" Sketches="SketchMap" Snapshots="SnapshotMap" Height="84" OnEdit="EditSketchByName" OnSnapshot="EditSketchByName" /></span>
                                        }
                                    </div>
                                    <div class="ab-rule-mid">
                                        <div class="ab-rule-line"></div>
                                        <span class="ab-rule-name">(@(string.IsNullOrWhiteSpace(rr.Name) ? rr.Kind : rr.Name))</span>
                                    </div>
                                    <div class="ab-rule-prem">
                                        @foreach (var c in rr.Conclusions)
                                        {
                                            <span class="@(c.Result.Success ? "" : "ab-bad-expr")" title="@(c.Result.Success ? "" : c.Result.Error)"
                                                  @onclick="() => ShowAnalysis(c)"><InlineExpr Text="@(c.Result.Success ? c.Result.Formatted : c.Raw)" Sketches="SketchMap" Snapshots="SnapshotMap" Height="84" OnEdit="EditSketchByName" OnSnapshot="EditSketchByName" /></span>
                                        }
                                    </div>
                                </div>
                                <span class="ab-rule-corner">
                                    <button type="button" class="ab-rule-info" title="Edit this rule in the builder"
                                            @onclick="() => EditRule(rr)">
                                        <i class="fa-solid fa-pencil"></i>
                                    </button>
                                    <button type="button" class="ab-rule-info" title="How to interpret this rule"
                                            @onclick="() => ToggleRemark(rr)">
                                        <i class="fa-solid fa-circle-info"></i>
                                    </button>
                                    <button type="button" class="ab-tag-x big" title="Delete rule"
                                            @onclick='() => AskDelete("rule", rules.IndexOf(rr), rr.Name)'>×</button>
                                </span>
                            </div>
                            @if (openRemarks.Contains(rr))
                            {
                                <div class="ab-rule-remark">
                                    @if (!string.IsNullOrEmpty(rr.LongName))
                                    {
                                        <div class="ab-pal-long">@rr.LongName</div>
                                    }
                                    @if (!string.IsNullOrEmpty(rr.Description))
                                    {
                                        <p>@rr.Description</p>
                                    }
                                    <pre><RefText Text="@RuleRemark(rr)" Sketches="SketchMap" OnEdit="EditSketchByName" /></pre>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    }
</div>

@if (sketchModalOpen)
{
    <div class="ab-modal-overlay" @onclick="CloseSketchModal">
        <div class="ab-modal ab-sketch-modal" @onclick:stopPropagation>
            <h5><i class="fa-solid fa-compass-drafting" style="color: var(--ab-accent)"></i> New sketch</h5>
            <label class="ab-setting-label">Sketch name</label>
            <input class="ab-text-input" value="@sketchNameInput"
                   @oninput="e => sketchNameInput = e.Value?.ToString() ?? string.Empty" />
            <label class="ab-setting-label">Diagram (quiver JSON / base64 — or draw it in the editor)</label>
            <textarea class="ab-editor" rows="3" spellcheck="false" style="font-size:.9rem; font-family:Consolas, monospace"
                      value="@sketchJsonInput" @oninput="e => sketchJsonInput = e.Value?.ToString() ?? string.Empty"></textarea>
            @if (!string.IsNullOrEmpty(sketchSnapshotInput))
            {
                <img class="ab-snap-card" src="@sketchSnapshotInput" alt="snapshot" title="click to edit" @onclick="OpenSketchOverlayFromModal" />
            }
            else
            {
                <button type="button" class="ab-snap-missing-card" @onclick="OpenSketchOverlayFromModal">
                    <i class="fa-solid fa-camera"></i> draw it in the editor and take the snapshot
                </button>
            }
            <div class="ab-modal-btns">
                <button type="button" class="ab-kind-btn" @onclick="CloseSketchModal">Cancel</button>
                <button type="button" class="ab-kind-btn" @onclick="OpenSketchOverlayFromModal">
                    <i class="fa-solid fa-pen-ruler"></i> Draw in quiver
                </button>
                <button type="button" class="ab-btn-primary sm" @onclick="SaveSketch"
                        disabled="@(!SketchNameValid)">
                    <i class="fa-solid fa-circle-plus"></i> Add sketch
                </button>
            </div>
            @if (!SketchNameValid)
            {
                <div class="ab-muted" style="margin-top:.4rem">Name must be letters/digits/underscore/hyphen, start with a letter, not end with a hyphen, and be unused.</div>
            }
            @foreach (var w in SketchWarnings())
            {
                <div class="ab-muted ab-sketch-warn"><i class="fa-solid fa-triangle-exclamation"></i> @w</div>
            }
        </div>
    </div>
}

@if (sketchOverlayOpen)
{
    <div class="ab-sketch-overlay">
        <iframe id="sketch-frame" class="ab-sketch-frame" src="@sketchOverlaySrc" title="quiver editor"></iframe>
        <div class="ab-sketch-overlay-bar">
            <span>Draw the diagram, press quiver's <strong>Save</strong> (Ctrl+S), then the check to bring it back.</span>
            @if (SnapshotSvc is not null)
            {
                <button type="button" id="re-snap-btn" class="ab-kind-btn ab-snap-btn" @onclick="TakeSnapshot" disabled="@snapBusy"
                        title="Store a picture of the diagram as drawn; previews then show it instead of loading a live quiver frame">
                    <i class="fa-solid fa-camera"></i> @(snapBusy ? "…" : "Snapshot")
                </button>
                @if (HasSnapshotInOverlay)
                {
                    <button type="button" class="ab-kind-btn ab-snap-btn" @onclick="ClearSnapshot" title="drop the stored picture — previews load the live frame again">
                        <i class="fa-solid fa-camera-slash"></i> Clear
                    </button>
                }
                @if (snapNote is not null) { <span class="ab-snap-note">@snapNote</span> }
            }
        </div>
        <button type="button" class="ab-sketch-done" title="Done — import the diagram and close" @onclick="CloseSketchOverlay">
            <svg viewBox="0 0 24 24" width="26" height="26" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 12.5 L9.5 18 L20 6.5" fill="none" stroke="currentColor" stroke-width="3"
                      stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
    </div>
}

@if (snapToast is not null)
{
    <div class="ab-snap-toast"><img src="@snapToast" alt="snapshot" /><span><i class="fa-solid fa-check"></i> snapshot stored</span></div>
}

@if (pendingExample is not null)
{
    <div class="ab-modal-overlay" @onclick="() => pendingExample = null">
        <div class="ab-modal" @onclick:stopPropagation>
            <h5><i class="fa-solid fa-boxes-packing" style="color: var(--ab-accent)"></i> Load example palette</h5>
            <p><strong>@pendingExample.Name</strong> — @pendingExample.Rules.Length rules</p>
            <p class="ab-muted">@pendingExample.Description</p>
            <div class="ab-modal-btns">
                <button type="button" class="ab-kind-btn" @onclick="() => pendingExample = null">Cancel</button>
                <button type="button" class="ab-kind-btn" @onclick="() => LoadExample(replace: false)">Append to system</button>
                <button type="button" class="ab-btn-primary sm" @onclick="() => LoadExample(replace: true)">Replace system</button>
            </div>
        </div>
    </div>
}

@if (pendingDelete is not null)
{
    <div class="ab-modal-overlay" @onclick="() => pendingDelete = null">
        <div class="ab-modal" @onclick:stopPropagation>
            <h5><i class="fa-solid fa-triangle-exclamation"></i> Confirm delete</h5>
            <p>Delete @pendingDelete.Value.Kind @(string.IsNullOrWhiteSpace(pendingDelete.Value.Label) ? "" : $"“{pendingDelete.Value.Label}”")?</p>
            <div class="ab-modal-btns">
                <button type="button" class="ab-kind-btn" @onclick="() => pendingDelete = null">Cancel</button>
                <button type="button" class="ab-btn-danger" @onclick="ConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    static string[] Kinds => SystemStore.Kinds;

    class TagItem
    {
        public string Raw = "";
        public RunResult Result = default!;
        /// <summary>the other face of a "[D] in C" expression (expanded ⇄ contracted)</summary>
        public string? Alt;
    }

    class Rule
    {
        public string Name = "";
        public string Kind = "Introduction";
        public string LongName = "";
        public string Description = "";
        public List<TagItem> Premises = new();
        public List<TagItem> Conclusions = new();
    }

    // DTO shapes (RuleDto/SketchDto/SystemDto) live in Shared/SystemStore.cs,
    // shared with the prover page.

    class Sketch
    {
        public string Name = "";
        public string Json = "";
        public string? Snapshot;
    }

    string systemName = "";
    string kind = "Introduction";
    string ruleName = "";
    bool nameEditing;
    bool activeIsPremise;
    int activeIdx = -1;
    List<TagItem> premises = new();
    List<TagItem> conclusions = new();
    List<Rule> rules = new();
    RunResult? analysis;
    (string Kind, int Index, string Label)? pendingDelete;
    bool readingOpen;
    string builderLongName = "";
    string builderDescription = "";
    Rule? editingRule;
    bool exportCopied;

    static readonly System.Text.RegularExpressions.Regex InCatRx =
        new(@"\[([^\[\]\s]+)\]\s+in\s+([A-Za-z][A-Za-z0-9_]*)");

    bool CanToggle(TagItem t) =>
        t.Alt is not null
        || InCatRx.Matches(t.Raw).Cast<System.Text.RegularExpressions.Match>()
            .Any(m => sketches.Any(s => s.Name == m.Groups[1].Value));

    // swap a tag between "[D] in C" and its equivalent textual judgment group
    async Task ToggleExpand(TagItem t)
    {
        if (t.Alt is string other)
        {
            var run = Api.Run(other);
            if (!run.Success) { analysis = run; return; }
            (t.Raw, t.Alt) = (other, t.Raw);
            t.Result = run;
        }
        else
        {
            var expanded = InCatRx.Replace(t.Raw, m =>
            {
                var sk = sketches.FirstOrDefault(s => s.Name == m.Groups[1].Value);
                if (sk is null) return m.Value;
                var ex = QuiverImport.TryExpand(sk.Json, m.Groups[2].Value);
                return ex.Ok ? ex.Text : m.Value;
            });
            if (expanded == t.Raw) return;
            var run = Api.Run(expanded);
            if (!run.Success) { analysis = run; return; }
            t.Alt = t.Raw;
            t.Raw = expanded;
            t.Result = run;
        }
        analysis = t.Result;
        await Save();
    }

    // ---- tabbed builder -----------------------------------------------------

    // tab caption = the entry's content (formatted when it parses), elided on the
    // LEFT — the tail of a judgment distinguishes it better than the shared head;
    // P1/C1 only as a fallback for blank tabs
    static string TabLabel(TagItem t, string prefix, int idx)
    {
        var text = (t.Result.Success ? t.Result.Formatted : t.Raw)?.Trim() ?? "";
        if (text.Length == 0) return $"{prefix}{idx + 1}";
        return text.Length <= 26 ? text : "…" + text[^25..];
    }

    // ---- tab reordering (drag) ---------------------------------------------
    // A tab DEPENDS on another when it mentions a name that other tab declares
    // ("A : C" depends on "C : BigCat"). Declarations must come first, so a
    // drag that would put a use before its declaration is refused.

    bool dragIsPremise;
    int dragIdx = -1;
    bool dragOverIsPremise;
    int dragOverIdx = -1;
    string? dragError;

    string DragClass(bool isPrem, int idx) =>
        dragIdx < 0 ? ""
        : isPrem == dragIsPremise && dragIdx == idx ? "dragging"
        : isPrem == dragOverIsPremise && dragOverIdx == idx ? "dropzone" : "";

    void DragStart(bool isPrem, int idx)
    {
        dragIsPremise = isPrem;
        dragIdx = idx;
        dragOverIdx = -1;
        dragError = null;
    }

    void DragEnter(bool isPrem, int idx)
    {
        if (dragIdx < 0) return;
        dragOverIsPremise = isPrem;
        dragOverIdx = idx;
    }

    void DragEnd()
    {
        dragIdx = -1;
        dragOverIdx = -1;
    }

    /// <summary>Drop the dragged tab at <paramref name="idx"/> of the premise
    /// (or conclusion) row — reordering within a row, or switching its side.
    /// A drop onto a pill also bubbles to its row; DragEnd clears the drag
    /// first, so the row's handler is a no-op after a pill handled it.</summary>
    void Drop(bool toPrem, int idx)
    {
        var from = dragIdx;
        var fromPrem = dragIsPremise;
        DragEnd();
        if (from < 0) return;
        var src = fromPrem ? premises : conclusions;
        if (from >= src.Count) return;
        var moved = src[from];

        if (fromPrem == toPrem)
        {
            if (from == idx) return;
            var cand = src.ToList();
            cand.RemoveAt(from);
            cand.Insert(Math.Clamp(idx, 0, cand.Count), moved);
            if (DependencyViolation(cand) is { } why)
            {
                dragError = "Can't move there — " + why;
                return;
            }
            dragError = null;
            var keep = ActiveTag;
            if (toPrem) premises = cand; else conclusions = cand;
            if (keep is not null && activeIsPremise == toPrem)
            {
                var at = cand.IndexOf(keep);
                if (at >= 0) activeIdx = at;
            }
        }
        else
        {
            // crossing the line: the tab changes side, keeping its text
            var dst = (toPrem ? premises : conclusions).ToList();
            dst.Insert(Math.Clamp(idx, 0, dst.Count), moved);
            if (DependencyViolation(dst) is { } why)
            {
                dragError = "Can't move there — " + why;
                return;
            }
            var rest = src.ToList();
            rest.RemoveAt(from);
            if (fromPrem) { premises = rest; conclusions = dst; }
            else { conclusions = rest; premises = dst; }
            dragError = null;
            // follow the tab to its new side so the editor stays on it
            activeIsPremise = toPrem;
            activeIdx = dst.IndexOf(moved);
        }
    }

    void SortTabs()
    {
        var activeTag = ActiveTag;
        premises = TopoSort(premises);
        conclusions = TopoSort(conclusions);
        dragError = null;
        if (activeTag is not null)
        {
            var at = ActiveList.IndexOf(activeTag);
            if (at >= 0) activeIdx = at;
        }
    }

    // (declaredNames, mentionedNames) per tab — parse-only, so cheap. A tab can
    // declare several names at once: "[Four] in C" declares every object and
    // arrow of the diagram.
    static (List<HashSet<string>> Declared, List<HashSet<string>> Mentions) DepInfo(List<TagItem> items) =>
        (items.Select(t => new HashSet<string>(Api.DeclaredNames(t.Raw))).ToList(),
         items.Select(t => new HashSet<string>(Api.MentionedNames(t.Raw))).ToList());

    /// <summary>The first use-before-declaration in this order, if any.</summary>
    static string? DependencyViolation(List<TagItem> order)
    {
        var (declared, mentions) = DepInfo(order);
        for (var x = 0; x < order.Count; x++)
            for (var y = x + 1; y < order.Count; y++)
            {
                // the later tab declares a name the earlier one uses without declaring
                var d = declared[y].FirstOrDefault(n => !declared[x].Contains(n) && mentions[x].Contains(n));
                if (d is not null)
                    return $"“{TabLabel(order[x], "P", x)}” uses {d}, which “{TabLabel(order[y], "P", y)}” declares — a declaration has to come before its uses.";
            }
        return null;
    }

    static List<TagItem> TopoSort(List<TagItem> items)
    {
        var (declared, mentions) = DepInfo(items);
        var remaining = Enumerable.Range(0, items.Count).ToList();
        var result = new List<TagItem>();
        while (remaining.Count > 0)
        {
            // the first tab whose declarations-it-needs are all already placed;
            // on a dependency cycle, fall back to the original order
            var pick = remaining.FirstOrDefault(
                i => remaining.All(j => j == i
                                        || !declared[j].Any(n => !declared[i].Contains(n) && mentions[i].Contains(n))),
                -1);
            if (pick < 0) pick = remaining[0];
            result.Add(items[pick]);
            remaining.Remove(pick);
        }
        return result;
    }

    // memoized on the tabs' content so it never re-parses per render
    string? orderWarnSig;
    string? orderWarn;
    string? OrderWarning
    {
        get
        {
            var sig = string.Join("", premises.Select(t => t.Raw))
                      + "" + string.Join("", conclusions.Select(t => t.Raw));
            if (sig != orderWarnSig)
            {
                orderWarnSig = sig;
                orderWarn = DependencyViolation(premises) ?? DependencyViolation(conclusions);
            }
            return orderWarn;
        }
    }

    List<TagItem> ActiveList => activeIsPremise ? premises : conclusions;
    TagItem? ActiveTag => activeIdx >= 0 && activeIdx < ActiveList.Count ? ActiveList[activeIdx] : null;
    string ActiveRaw => ActiveTag?.Raw ?? "";

    // abandoned blank tabs disappear; the given tag (if any) survives
    void PruneBlanks(TagItem? keep)
    {
        premises.RemoveAll(t => t != keep && string.IsNullOrWhiteSpace(t.Raw));
        conclusions.RemoveAll(t => t != keep && string.IsNullOrWhiteSpace(t.Raw));
    }

    void SelectTab(bool isPremise, int idx)
    {
        var list = isPremise ? premises : conclusions;
        if (idx < 0 || idx >= list.Count) return;
        var target = list[idx];
        PruneBlanks(target);
        activeIsPremise = isPremise;
        activeIdx = (isPremise ? premises : conclusions).IndexOf(target);
        analysis = string.IsNullOrWhiteSpace(target.Raw) ? null : target.Result;
    }

    void NewTab(bool isPremise)
    {
        PruneBlanks(null);
        var tag = new TagItem { Raw = "", Result = Api.Run("") };
        (isPremise ? premises : conclusions).Add(tag);
        activeIsPremise = isPremise;
        activeIdx = (isPremise ? premises : conclusions).Count - 1;
        analysis = null;
    }

    void OnActiveChanged(string v)
    {
        if (ActiveTag is null)
        {
            if (string.IsNullOrWhiteSpace(v)) return;
            NewTab(activeIsPremise);
        }
        var t = ActiveTag!;
        if (t.Raw != v) t.Alt = null;   // manual edit invalidates the ⇄ pair
        t.Raw = v;
        t.Result = Api.Run(v);
        analysis = string.IsNullOrWhiteSpace(v) ? null : t.Result;
    }

    // Enter: finish this entry and open the next one on the same side
    void OnActiveSubmit(string _)
    {
        if (ActiveTag is null || string.IsNullOrWhiteSpace(ActiveTag.Raw)) return;
        NewTab(activeIsPremise);
    }

    async Task ToggleActive()
    {
        if (ActiveTag is not null) await ToggleExpand(ActiveTag);
    }

    async Task EditRule(Rule r)
    {
        editingRule = r;
        kind = r.Kind;
        ruleName = r.Name;
        builderLongName = r.LongName;
        builderDescription = r.Description;
        premises = r.Premises.Select(t => new TagItem { Raw = t.Raw, Result = t.Result }).ToList();
        conclusions = r.Conclusions.Select(t => new TagItem { Raw = t.Raw, Result = t.Result }).ToList();
        nameEditing = false;
        activeIsPremise = conclusions.Count == 0 && premises.Count > 0;
        activeIdx = (activeIsPremise ? premises : conclusions).Count > 0 ? 0 : -1;
        analysis = r.Conclusions.FirstOrDefault()?.Result ?? r.Premises.FirstOrDefault()?.Result;
        try { await JS.InvokeVoidAsync("eval", "document.querySelector('.ab-rule-editor-grid')?.scrollIntoView({behavior:'smooth'})"); } catch { }
    }

    void CancelEdit()
    {
        editingRule = null;
        premises = new();
        conclusions = new();
        ruleName = "";
        builderLongName = "";
        builderDescription = "";
        nameEditing = false;
        activeIdx = -1;
        analysis = null;
    }

    async Task ExportSystem()
    {
        var dto = new SystemDto
        {
            Name = systemName,
            SemanticsVersion = semanticsVersion,
            Constants = ConstantsList.ToList(),
            Rules = rules.Select(r => new RuleDto
            {
                Name = r.Name, Kind = r.Kind, LongName = r.LongName, Description = r.Description,
                Premises = r.Premises.Select(t => t.Raw).ToList(),
                Conclusions = r.Conclusions.Select(t => t.Raw).ToList(),
            }).ToList(),
            Sketches = sketches.Select(s => new SketchDto { Name = s.Name, Json = s.Json, Snapshot = s.Snapshot }).ToList(),
        };
        var json = JsonSerializer.Serialize(dto, new JsonSerializerOptions { WriteIndented = true });
        try
        {
            await JS.InvokeVoidAsync("eval", $"navigator.clipboard.writeText({JsonSerializer.Serialize(json)})");
            exportCopied = true;
            _ = ResetCopiedLater();
        }
        catch { }
    }

    async Task ResetCopiedLater()
    {
        await Task.Delay(1600);
        exportCopied = false;
        await InvokeAsync(StateHasChanged);
    }
    readonly HashSet<Rule> openRemarks = new();
    readonly Dictionary<Rule, string> remarkCache = new();

    void ToggleRemark(Rule r)
    {
        if (!openRemarks.Remove(r)) openRemarks.Add(r);
    }

    // one deduplicated typing line per distinct symbol across the whole rule —
    // this is where "what is σ typed as?" gets its answer
    string RuleRemark(Rule r)
    {
        if (remarkCache.TryGetValue(r, out var cached)) return cached;
        var seen = new HashSet<string>();
        var lines = new List<string>();
        foreach (var t in r.Premises.Concat(r.Conclusions))
        {
            foreach (var line in (t.Result.Inference ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries))
            {
                var subject = line.Split(' ')[0];
                if (seen.Add(subject)) lines.Add(line);
            }
        }
        var remark = lines.Count == 0 ? "No leaves to type." : string.Join("\n", lines);
        remarkCache[r] = remark;
        return remark;
    }
    ExampleSystems.ExampleSystem? pendingExample;
    string exampleSel = "";

    void OnExampleSelected(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        exampleSel = "";
        pendingExample = ExampleSystems.All.FirstOrDefault(x => x.Name == name);
    }

    async Task LoadExample(bool replace)
    {
        if (pendingExample is null) return;
        var ex = pendingExample;
        pendingExample = null;
        if (replace)
        {
            rules.Clear();
            systemName = ex.Name;
            constantsInput = "";
        }
        // the palette's rigid constants must be declared BEFORE its rules are
        // parsed, or its own names would come out as metavariables
        var consts = ConstantsList.Concat(ex.Constants ?? Array.Empty<string>()).Distinct().ToArray();
        constantsInput = string.Join(" ", consts);
        Api.SetConstants(consts);
        // the palettes are written for the built-in diagram semantics
        semanticsVersion = 2;
        Api.SetDiagramSemantics(true);
        // parsing every rule of an example palette is CPU work — keep it off the UI thread
        var built = await Task.Run(() => ex.Rules
            .Select(en => new Rule
            {
                Name = en.Name,
                Kind = en.Kind,
                LongName = en.LongName,
                Description = en.Description,
                Premises = MakeTags(en.Premises),
                Conclusions = MakeTags(en.Conclusions),
            })
            .ToList());
        rules.AddRange(built);
        foreach (var (name, json) in ex.Sketches ?? Array.Empty<(string, string)>())
        {
            if (!sketches.Any(s => s.Name == name))
                sketches.Add(new Sketch { Name = name, Json = json });
        }
        // rules already in the system may read differently under the new
        // constants, so re-read everything
        await ReparseAll();
        await Save();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (teachPending && sketchOverlayOpen)
        {
            teachPending = false;
            try { await JS.InvokeVoidAsync("abEditor.teach", "re-snap-btn", "Position the diagram so it is fully in view, press quiver's Save (Ctrl+S), then take the Snapshot — it becomes the picture shown everywhere.", 20000); } catch { }
        }
        if (firstRender)
        {
            var dto = await SystemStore.LoadAsync(JS);
            systemName = dto.Name;
            constantsInput = string.Join(" ", dto.Constants);
            semanticsVersion = dto.SemanticsVersion;
            Api.SetConstants(dto.Constants.ToArray());
            Api.SetDiagramSemantics(dto.DiagramSemantics);
            Api.SetSketches(dto.Sketches.Select(s => Tuple.Create(s.Name, s.Json)).ToArray());
            // parsing + canonicalization is CPU work — keep it off the UI thread
            var (loadedRules, loadedSketches) = await Task.Run(() =>
            {
                var rs = dto.Rules
                    .Select(r => new Rule
                    {
                        Name = r.Name,
                        Kind = Kinds.Contains(r.Kind) ? r.Kind : "Introduction",
                        LongName = r.LongName,
                        Description = r.Description,
                        Premises = r.Premises.Select(MakeTag).Where(t => t != null).Select(t => t!).ToList(),
                        Conclusions = r.Conclusions.Select(MakeTag).Where(t => t != null).Select(t => t!).ToList(),
                    })
                    .ToList();
                var sk = dto.Sketches.Select(s => new Sketch { Name = s.Name, Json = QuiverImport.NormalizePositions(s.Json), Snapshot = s.Snapshot }).ToList();
                return (rs, sk);
            });
            rules = loadedRules;
            sketches = loadedSketches;
            RefreshSketchMap();
            rulesLoading = false;
            StateHasChanged();
            await OpenRequestedRule();
        }
    }

    // a link from another page: rules?edit=<name> — load that rule into the
    // builder and light its card up in the palette
    Rule? highlightRule;
    async Task OpenRequestedRule()
    {
        string? wanted = null;
        try
        {
            var q = new Uri(Nav.Uri).Query.TrimStart('?');
            foreach (var part in q.Split('&', StringSplitOptions.RemoveEmptyEntries))
            {
                var kv = part.Split('=', 2);
                if (kv.Length == 2 && kv[0] == "edit") wanted = Uri.UnescapeDataString(kv[1].Replace('+', ' '));
            }
        }
        catch { }
        if (string.IsNullOrEmpty(wanted)) return;
        var r = rules.FirstOrDefault(x => x.Name == wanted);
        if (r is null) return;
        highlightRule = r;
        await EditRule(r);
        StateHasChanged();
        // the palette's snapshots decode after the first paint and shift the
        // layout under the scroll, so scroll now and again once every picture is in
        var js = "setTimeout(function(){"
            + $"var el=document.getElementById('rule-card-{rules.IndexOf(r)}'); if(!el) return;"
            + "var go=function(){el.scrollIntoView({behavior:'smooth', block:'center'});}; go();"
            + "var pending=[].slice.call(document.images).filter(function(i){return !i.complete;});"
            + "if(pending.length) Promise.all(pending.map(function(i){return new Promise(function(d){i.onload=i.onerror=d;});})).then(function(){setTimeout(go, 60);});"
            + "}, 400)";
        try { await JS.InvokeVoidAsync("eval", js); } catch { }
        _ = Task.Run(async () => { await Task.Delay(6000); highlightRule = null; await InvokeAsync(StateHasChanged); });
    }

    static TagItem? MakeTag(string raw)
    {
        var r = Api.Run(raw);
        return r.Success ? new TagItem { Raw = raw, Result = r } : null;
    }

    // keep-variant: a failed parse stays in the rule (shown by its raw text)
    // so a constants change can never silently drop content
    static TagItem MakeTagKeep(string raw) => new TagItem { Raw = raw, Result = Api.Run(raw) };

    async Task Save()
    {
        RefreshSketchMap();   // every sketch mutation ends in Save(), so the cache can't go stale
        var dto = new SystemDto
        {
            Name = systemName,
            SemanticsVersion = semanticsVersion,
            Constants = ConstantsList.ToList(),
            Rules = rules.Select(r => new RuleDto
            {
                Name = r.Name,
                Kind = r.Kind,
                LongName = r.LongName,
                Description = r.Description,
                Premises = r.Premises.Select(t => t.Raw).ToList(),
                Conclusions = r.Conclusions.Select(t => t.Raw).ToList(),
            }).ToList(),
            Sketches = sketches.Select(s => new SketchDto { Name = s.Name, Json = s.Json, Snapshot = s.Snapshot }).ToList(),
        };
        await SystemStore.SaveAsync(JS, dto);
    }

    async Task OnSystemName(ChangeEventArgs e)
    {
        systemName = e.Value?.ToString() ?? "";
        await Save();
    }

    // ---- per-system rigid constants ----------------------------------------

    string constantsInput = "";
    // 2 = the built-in ∀∃ reading of "[D] commutes"; 1 = opaque token (older systems)
    int semanticsVersion = 2;

    async Task OnSemanticsToggle(ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        semanticsVersion = on ? 2 : 1;
        Api.SetDiagramSemantics(on);
        await ReparseAll();
        await Save();
    }

    string[] ConstantsList =>
        constantsInput.Split(new[] { ' ', ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
                      .Distinct().ToArray();

    async Task OnConstantsChanged(ChangeEventArgs e)
    {
        constantsInput = e.Value?.ToString() ?? "";
        Api.SetConstants(ConstantsList);
        await ReparseAll();
        await Save();
    }

    // constants change what parses as a metavariable, so every stored
    // expression must be re-read; failures are kept (marked), never dropped
    async Task ReparseAll()
    {
        rulesLoading = true;
        StateHasChanged();
        var work = rules.Select(r => (Rule: r,
                                      P: r.Premises.Select(t => t.Raw).ToArray(),
                                      C: r.Conclusions.Select(t => t.Raw).ToArray())).ToList();
        var prem = premises.Select(t => t.Raw).ToArray();
        var concl = conclusions.Select(t => t.Raw).ToArray();
        await Task.Run(() =>
        {
            foreach (var w in work)
            {
                w.Rule.Premises = w.P.Select(MakeTagKeep).ToList();
                w.Rule.Conclusions = w.C.Select(MakeTagKeep).ToList();
            }
        });
        premises = prem.Select(MakeTagKeep).ToList();
        conclusions = concl.Select(MakeTagKeep).ToList();
        analysis = null;
        rulesLoading = false;
    }

    void ShowAnalysis(TagItem t) => analysis = t.Result;

    void AskDelete(string what, int index, string label) =>
        pendingDelete = (what, index, label);

    async Task ConfirmDelete()
    {
        if (pendingDelete is null) return;
        var (what, idx, _) = pendingDelete.Value;
        pendingDelete = null;
        switch (what)
        {
            case "premise" when idx >= 0 && idx < premises.Count:
                premises.RemoveAt(idx);
                if (activeIsPremise) activeIdx = Math.Min(activeIdx, premises.Count - 1);
                break;
            case "conclusion" when idx >= 0 && idx < conclusions.Count:
                conclusions.RemoveAt(idx);
                if (!activeIsPremise) activeIdx = Math.Min(activeIdx, conclusions.Count - 1);
                break;
            case "rule" when idx >= 0 && idx < rules.Count:
                rules.RemoveAt(idx);
                await Save();
                break;
            case "sketch" when idx >= 0 && idx < sketches.Count:
                sketches.RemoveAt(idx);
                await Save();
                break;
            case "system":
                rules.Clear();
                sketches.Clear();
                editingRule = null;
                await Save();
                break;
        }
    }

    // ---- sketches -----------------------------------------------------------

    List<Sketch> sketches = new();
    bool sketchGalleryOpen;
    bool rulesLoading = true;
    // cached: a stable reference lets Blazor skip re-rendering every InlineExpr
    // (and its per-sketch JSON parse) on unrelated state changes
    IReadOnlyDictionary<string, string> sketchMapCache = new Dictionary<string, string>();
    IReadOnlyDictionary<string, string> SketchMap => sketchMapCache;
    void RefreshSketchMap()
    {
        sketchMapCache = sketches.ToDictionary(s => s.Name, s => s.Json);
        snapshotMapCache = sketches.Where(s => !string.IsNullOrEmpty(s.Snapshot)).ToDictionary(s => s.Name, s => s.Snapshot!);
        // the kernel matches diagrams by shape and reads their labels — it
        // needs the pictures, not just the names
        Api.SetSketches(sketches.Select(s => Tuple.Create(s.Name, s.Json)).ToArray());
    }
    bool sketchModalOpen;
    string sketchNameInput = "";
    string sketchJsonInput = "";
    bool sketchTargetIsPremise;
    bool sketchOverlayOpen;
    string sketchOverlaySrc = "";
    Sketch? overlaySketch;   // set when editing an existing sketch from the gallery

    // save-time advice for the sketch being added (∀∃ reading), cached per JSON
    string sketchWarnJson = "";
    string[] sketchWarnings = Array.Empty<string>();
    string[] SketchWarnings()
    {
        if (semanticsVersion < 2 || string.IsNullOrWhiteSpace(sketchJsonInput)) return Array.Empty<string>();
        if (sketchWarnJson != sketchJsonInput)
        {
            sketchWarnJson = sketchJsonInput;
            try { sketchWarnings = QuiverImport.LabelWarnings(sketchJsonInput); }
            catch { sketchWarnings = Array.Empty<string>(); }
        }
        return sketchWarnings;
    }

    bool SketchNameValid =>
        sketchNameInput.Length > 0
        && char.IsLetter(sketchNameInput[0])
        && sketchNameInput.All(c => char.IsLetterOrDigit(c) || c == '_' || c == '-' || "₀₁₂₃₄₅₆₇₈₉₊₋₌".Contains(c))
        && sketchNameInput[^1] != '-'
        && !sketches.Any(s => s.Name == sketchNameInput);

    void OpenSketchModal(bool isPremise)
    {
        sketchTargetIsPremise = isPremise;
        var i = sketches.Count + 1;
        while (sketches.Any(s => s.Name == $"D{i}")) i++;
        sketchNameInput = $"D{i}";
        sketchJsonInput = "";
        sketchModalOpen = true;
    }

    void CloseSketchModal() => sketchModalOpen = false;

    async Task SaveSketch()
    {
        if (!SketchNameValid) return;
        sketches.Add(new Sketch { Name = sketchNameInput, Json = QuiverImport.NormalizePositions(sketchJsonInput), Snapshot = sketchSnapshotInput });
        sketchSnapshotInput = null;
        sketchModalOpen = false;
        // append the reference into the active tab on the target side
        if (activeIsPremise != sketchTargetIsPremise || ActiveTag is null)
        {
            activeIsPremise = sketchTargetIsPremise;
            activeIdx = ActiveList.Count - 1;
            if (ActiveTag is null) NewTab(sketchTargetIsPremise);
        }
        var current = ActiveRaw;
        OnActiveChanged(current + (current.Length > 0 ? " " : "") + $"[{sketchNameInput}] ");
        await Save();
    }

    static string ToQuiverFragment(string json)
    {
        var t = (json ?? "").Trim();
        if (t.Length == 0) return "";
        var b64 = t.StartsWith("[") ? Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(t)) : t;
        return "#q=" + b64;
    }

    void OpenSketchOverlayFromModal()
    {
        teachPending = SnapshotSvc is not null;
        overlaySketch = null;   // result goes back into the modal's JSON box
        sketchOverlaySrc = "_content/AbCatDC.RazorLib/quiver/index.html" + ToQuiverFragment(sketchJsonInput);
        sketchOverlayOpen = true;
    }

    void OpenSketchOverlay(Sketch s)
    {
        teachPending = SnapshotSvc is not null;
        overlaySketch = s;
        sketchOverlaySrc = "_content/AbCatDC.RazorLib/quiver/index.html" + ToQuiverFragment(s.Json);
        sketchOverlayOpen = true;
    }

    // reached from the zoom overlay's edit button (RefText / InlineExpr links)
    void EditSketchByName(string name)
    {
        var s = sketches.FirstOrDefault(x => x.Name == name);
        if (s is not null) OpenSketchOverlay(s);
    }

    AbCatDC.RazorLib.Services.ISnapshotService? SnapshotSvc =>
        (AbCatDC.RazorLib.Services.ISnapshotService?)Services.GetService(typeof(AbCatDC.RazorLib.Services.ISnapshotService));
    bool snapBusy, teachPending;
    string? snapNote, snapToast;
    int snapToastSerial;

    async Task ShowSnapToast(string url)
    {
        snapToast = url;
        var serial = ++snapToastSerial;
        StateHasChanged();
        await Task.Delay(4200);
        if (serial == snapToastSerial) { snapToast = null; StateHasChanged(); }
    }
    string? sketchSnapshotInput;   // the modal path: a snapshot taken before the sketch is named
    bool HasSnapshotInOverlay => overlaySketch is not null ? overlaySketch.Snapshot is not null : sketchSnapshotInput is not null;

    // name → PNG data URL, for previews; a fresh dictionary only when it changes
    Dictionary<string, string> snapshotMapCache = new();
    IReadOnlyDictionary<string, string> SnapshotMap => snapshotMapCache;

    async Task TakeSnapshot()
    {
        var svc = SnapshotSvc;
        if (svc is null || snapBusy) return;
        snapBusy = true;
        snapNote = null;
        try
        {
            var b64 = await svc.CapturePngBase64Async();
            var url = string.IsNullOrEmpty(b64) ? "" : await JS.InvokeAsync<string>("abEditor.cropSnapshot", b64, "sketch-frame", 900);
            if (string.IsNullOrEmpty(url)) { snapNote = "could not capture"; }
            else
            {
                if (overlaySketch is not null) { overlaySketch.Snapshot = url; RefreshSketchMap(); await Save(); }
                else sketchSnapshotInput = url;
                snapNote = "stored";
                try { await JS.InvokeVoidAsync("abEditor.teachOff"); } catch { }
                _ = ShowSnapToast(url);
            }
        }
        catch (Exception ex) { snapNote = "capture failed: " + ex.Message; }
        snapBusy = false;
    }

    async Task ClearSnapshot()
    {
        if (overlaySketch is not null) { overlaySketch.Snapshot = null; RefreshSketchMap(); await Save(); }
        else sketchSnapshotInput = null;
        snapNote = "cleared";
    }

    async Task CloseSketchOverlay()
    {
        try { await JS.InvokeVoidAsync("abEditor.teachOff"); } catch { }
        // quiver writes #q=... into its URL on Save; same-origin lets us read it
        var b64 = "";
        try { b64 = await JS.InvokeAsync<string>("abEditor.readQuiverFrame", "sketch-frame"); }
        catch { }
        sketchOverlayOpen = false;
        if (!string.IsNullOrEmpty(b64))
        {
            // compact the layout so editor-dragged sprawl doesn't zoom previews out
            var normalized = QuiverImport.NormalizePositions(b64);
            if (overlaySketch is not null)
            {
                overlaySketch.Json = normalized;
                await Save();
            }
            else
            {
                sketchJsonInput = normalized;
            }
        }
        overlaySketch = null;
    }

    static List<TagItem> MakeTags(string[] raws) =>
        raws.Select(MakeTag).Where(t => t != null).Select(t => t!).ToList();

    // commit a builder tab: the stored rule carries the full (context-prefixed)
    // sequent text; invalid or blank tabs are dropped
    static List<TagItem> CommitTags(List<TagItem> tags) =>
        tags.Where(t => t.Result.Success)
            .Select(t => new TagItem { Raw = t.Raw, Result = t.Result, Alt = t.Alt })
            .ToList();

    async Task AddRule()
    {
        PruneBlanks(null);
        var committedPremises = CommitTags(premises);
        var committedConclusions = CommitTags(conclusions);
        if (committedConclusions.Count == 0) return;
        var built = new Rule
        {
            Name = ruleName.Trim(),
            Kind = kind,
            LongName = builderLongName,
            Description = builderDescription,
            Premises = committedPremises,
            Conclusions = committedConclusions,
        };
        if (editingRule is not null)
        {
            var idx = rules.IndexOf(editingRule);
            if (idx >= 0) rules[idx] = built; else rules.Add(built);
            remarkCache.Remove(editingRule);
            editingRule = null;
        }
        else
        {
            rules.Add(built);
        }
        premises = new();
        conclusions = new();
        ruleName = "";
        builderLongName = "";
        builderDescription = "";
        activeIdx = -1;
        analysis = null;
        await Save();
    }
}
