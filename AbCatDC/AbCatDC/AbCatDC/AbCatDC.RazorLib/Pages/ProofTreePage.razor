        var name = $"Tree {k}";
        while (blob.Trees.Any(t => t.Name == name)) name = $"Tree {++k}";
        blob.Trees.Add(new TreeDto { Name = name, SystemName = sys.Name });
        blob.Active = name;
        Rebuild();
        await Save();
    }

    async Task ApplyRename()
    {
        var nm = renameText.Trim();
        renaming = false;
        if (nm.Length == 0 || blob.Trees.Any(t => t.Name == nm)) return;
        Active.Name = nm;
        blob.Active = nm;
        await Save();
    }

