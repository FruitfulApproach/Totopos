    {
        StopSearch();
        blob.Trees.Remove(Active);
        if (blob.Trees.Count == 0) blob.Trees.Add(new TreeDto { Name = "Tree 1", SystemName = sys.Name });
        blob.Active = blob.Trees[0].Name;
