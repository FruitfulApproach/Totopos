    // ------------------------------------------------------------ wires
    void StartWire(int node, int idx, PointerEventArgs e)
    {
        dragNode = null;
        var p = PortPos(node, idx, false);
        if (p is null) return;
        pendingSrc = (node, idx);
        pendingStartX = pendingX = p.Value.x;
        pendingStartY = pendingY = p.Value.y;
        pendingClientX = e.ClientX;
        pendingClientY = e.ClientY;
    }

    async Task EndWire(int node, int idx)
    {
        if (pendingSrc is null)
        {
            await OnUp();
            return;
        }
        var src = pendingSrc.Value;
        pendingSrc = null;
        var id = Active.NextId;
        var msg = tree.Connect(id, src.node, src.idx, node, idx);
        if (msg.Length > 0)
        {
            toast = $"cannot wire: {msg}";
            Rebuild();
            return;
        }
        Active.NextId++;
        Active.Wires.RemoveAll(w => w.Dst == node && w.DstIdx == idx);
        Active.Wires.Add(new TreeWireDto { Id = id, Src = src.node, SrcIdx = src.idx, Dst = node, DstIdx = idx });
        toast = null;
        selectedWire = null;
        Refresh();
        await Save();
    }

    async Task RemoveWire(int id)
    {
        tree.Disconnect(id);
        Active.Wires.RemoveAll(w => w.Id == id);
        if (selectedWire == id) selectedWire = null;
        Refresh();
        await Save();
    }

    // ------------------------------------------------------------ pointer
    void StartDrag(TreeNodeDto n, PointerEventArgs e)
    {
        if (pendingSrc is not null) return;
        dragNode = n;
        dragCaptured = false;
        pressSerial++;
        pressX = lastX = e.ClientX;
        pressY = lastY = e.ClientY;
    }

    void OnLeave()
    {
        if (dragNode is null) pendingSrc = null;
    }

    async Task OnMove(PointerEventArgs e)
    {
        if (dragNode is not null)
        {
            var dx = (e.ClientX - lastX) / zoom;
            var dy = (e.ClientY - lastY) / zoom;
            // displacement from the PRESS point, well above the OS double-click rectangle:
            // a wobbly second click must never turn into a drag
            if (!dragCaptured && Math.Max(Math.Abs(e.ClientX - pressX), Math.Abs(e.ClientY - pressY)) < 6) return;
            if (!dragCaptured)
            {
                dragCaptured = true;
                var serial = pressSerial;
                var id = dragNode.Id;
                try { await JS.InvokeVoidAsync("abTree.capture", $"pt-node-{id}", e.PointerId); } catch { }
                if (serial != pressSerial || dragNode is null) return;   // a later press happened meanwhile
            }
            dragNode.X = Math.Max(0, dragNode.X + dx);
            dragNode.Y = Math.Max(0, dragNode.Y + dy);
            lastX = e.ClientX;
            lastY = e.ClientY;
            needMeasure = true;
        }
        else if (pendingSrc is not null)
        {
            pendingX = pendingStartX + (e.ClientX - pendingClientX) / zoom;
            pendingY = pendingStartY + (e.ClientY - pendingClientY) / zoom;
        }
    }

    async Task OnUp()
    {
        var moved = dragNode is not null && dragCaptured;
        dragNode = null;
        dragCaptured = false;
        pendingSrc = null;
        if (moved) await Save();
    }

    async Task StartResize(PointerEventArgs e)
    {
        resizing = true;
        resizeMoved = 0;
        resizeStartX = e.ClientX;
        resizeStartWidth = rightOpen ? rightWidth : 0;
        try { await JS.InvokeVoidAsync("abTree.capture", "pt-vdiv", e.PointerId); } catch { }
    }

    void OnResizeMove(PointerEventArgs e)
    {
        if (!resizing) return;
        var dx = resizeStartX - e.ClientX;
        resizeMoved = Math.Max(resizeMoved, Math.Abs(dx));
        if (resizeMoved > 4)
        {
            var w = resizeStartWidth + dx;
            rightOpen = w > 60;
            rightWidth = Math.Clamp(w, 200, 720);
            needMeasure = true;
        }
    }

    void EndResize()
    {
        if (!resizing) return;
        resizing = false;
        if (resizeMoved <= 4) rightOpen = !rightOpen;   // a click toggles
        needMeasure = true;
    }

    // ------------------------------------------------------------ automated search
    Task StartSearch()
    {
        if (searching) return Task.CompletedTask;
        searching = true;
        paused = false;
        searchStatus = "searching…";
        lastNote = "";
        cts = new CancellationTokenSource();
        var token = cts.Token;
        var engineTree = tree.Clone();
        var rules = sys.Rules
            .Where(r => r.Premises.Count + r.Conclusions.Count > 0)
            .Select(r => new SearchRule(string.IsNullOrWhiteSpace(r.Name) ? $"{r.Kind} rule" : r.Name, r.Kind, r.Premises.ToArray(), r.Conclusions.ToArray()))
            .ToArray();
        var engine = new ProofSearch(engineTree, rules, Active.NextId, 160, 7);
        var target = Active;
        _ = Task.Run(async () =>
        {
            try
            {
                while (!token.IsCancellationRequested)
                {
                    while (paused && !token.IsCancellationRequested) await Task.Delay(80, token);
                    if (token.IsCancellationRequested) break;
                    var mv = engine.Step();
                    if (mv is null) break;
                    var move = mv.Value;
                    await InvokeAsync(() =>
                    {
                        ApplyMove(target, move);
                        if (visualize)
                        {
                            Refresh();
                            var st = engine.Status;
                            searchStatus = $"step {st.Steps}: {move.Kind}";
                            lastNote = move.Note;
                            StateHasChanged();
                        }
                    });
                    if (visualize) await Task.Delay(DelayMs, token);
                }
            }
            catch (OperationCanceledException) { }
            catch (Exception ex)
            {
                await InvokeAsync(() => { toast = "search failed: " + ex.Message; });
            }
            await InvokeAsync(async () =>
            {
                var st = engine.Status;
                target.NextId = Math.Max(target.NextId, engine.NextId);
                searchStatus = token.IsCancellationRequested
                    ? $"stopped after {st.Steps} step{(st.Steps == 1 ? "" : "s")}"
                    : st.Solved ? $"solved in {st.Steps} step{(st.Steps == 1 ? "" : "s")}"
                    : st.Exhausted ? $"no applicable move left after {st.Steps} step{(st.Steps == 1 ? "" : "s")}"
                    : st.Note;
                searching = false;
                lastNode = -1;
                lastWires.Clear();
                Refresh();
                StateHasChanged();
                await Save();
            });
        });
        return Task.CompletedTask;
    }

    void StopSearch()
    {
        try { cts?.Cancel(); } catch { }
    }

    /// <summary>Mirror one move of the search onto the canvas and the page's own tree.</summary>
    void ApplyMove(TreeDto t, SearchMove mv)
    {
        lastWires.Clear();
        if (mv.NewNode >= 0)
        {
            var (x, y) = PlaceNew(mv.Anchor, mv.Above, mv.Wires.Length);
            var n = new TreeNodeDto
            {
                Id = mv.NewNode, IsRule = true, Role = "rule", RuleName = mv.RuleName, RuleKind = mv.RuleKind,
                Premises = mv.Premises.ToList(), Conclusions = mv.Conclusions.ToList(), X = x, Y = y
            };
            var e = tree.AddRule(n.Id, n.Premises.ToArray(), n.Conclusions.ToArray());
            if (e.Length > 0) n.Error = e;
            t.Nodes.Add(n);
            lastNode = n.Id;
        }
        foreach (var w in mv.Wires)
        {
            tree.Connect(w.Wire, w.Src, w.SrcIdx, w.Dst, w.DstIdx);
            t.Wires.RemoveAll(x => x.Dst == w.Dst && x.DstIdx == w.DstIdx);
            t.Wires.Add(new TreeWireDto { Id = w.Wire, Src = w.Src, SrcIdx = w.SrcIdx, Dst = w.Dst, DstIdx = w.DstIdx });
            lastWires.Add(w.Wire);
        }
        var maxId = Math.Max(t.Nodes.Count == 0 ? 0 : t.Nodes.Max(n => n.Id), t.Wires.Count == 0 ? 0 : t.Wires.Max(w => w.Id));
        t.NextId = Math.Max(t.NextId, maxId + 1);
    }

