    // ------------------------------------------------------------ lifecycle
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("eval", TreeJs); } catch { }
            selfRef = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("abTree.wheelZoom", "pt-canvas", "pt-surface", selfRef); } catch { }
            await LoadAll();
            loaded = true;
            needMeasure = true;
            StateHasChanged();
            return;
        }
        if (teachPending)
        {
            teachPending = false;
            try { await JS.InvokeVoidAsync("abEditor.teach", "pt-snap-btn", "Position the diagram so it is fully in view, press quiver's Save (Ctrl+S), then take the Snapshot — it becomes the picture shown everywhere.", 20000); } catch { }
        }
        if (!needMeasure) return;
        needMeasure = false;
        PortMeasure[] measured;
        NodeRect[] sizes;
        try
        {
            measured = await JS.InvokeAsync<PortMeasure[]>("abTree.measure", "pt-surface", zoom);
            sizes = await JS.InvokeAsync<NodeRect[]>("abTree.nodes", "pt-surface", zoom);
        }
        catch { return; }
        var changed = false;
        foreach (var m in measured)
        {
            if (!ports.TryGetValue(m.Key, out var old) || Math.Abs(old.X - m.X) > 0.5 || Math.Abs(old.Top - m.Top) > 0.5 || Math.Abs(old.Bottom - m.Bottom) > 0.5)
            {
                ports[m.Key] = m;
                changed = true;
            }
        }
        foreach (var s in sizes) rects[s.Id] = s;
        if (changed) StateHasChanged();
    }

    public void Dispose()
    {
        try { cts?.Cancel(); } catch { }
        selfRef?.Dispose();
    }

    async Task LoadAll()
    {
        sys = await SystemStore.LoadAsync(JS);
        Api.SetConstants(sys.Constants.ToArray());
        Api.SetDiagramSemantics(sys.DiagramSemantics);
        try
        {
            var json = await JS.InvokeAsync<string?>("abEditor.loadItem", StoreKey);
            if (!string.IsNullOrEmpty(json))
                blob = JsonSerializer.Deserialize<TreesBlob>(json) ?? new TreesBlob();
        }
        catch { }
        if (blob.Trees.Count == 0)
            blob.Trees.Add(new TreeDto { Name = "Tree 1", SystemName = sys.Name });
        if (blob.Trees.All(t => t.Name != blob.Active))
            blob.Active = blob.Trees[0].Name;
        Rebuild();
    }

    async Task Save()
    {
        try { await JS.InvokeVoidAsync("abEditor.saveItem", StoreKey, JsonSerializer.Serialize(blob)); }
        catch { }
    }

    // cached: InlineExpr takes the dictionaries by reference, a fresh one each render would re-embed every picture
    Dictionary<string, string> sketchMap = new();
    Dictionary<string, string> snapshotMap = new();

    void RegisterSketches()
    {
        var all = new Dictionary<string, string>();
        foreach (var s in sys.Sketches) all[s.Name] = s.Json;
        foreach (var s in Active.Sketches) all[s.Name] = s.Json;
        sketchMap = all;
        var snaps = new Dictionary<string, string>();
        foreach (var s in sys.Sketches.Concat(Active.Sketches)) if (!string.IsNullOrEmpty(s.Snapshot)) snaps[s.Name] = s.Snapshot!;
        snapshotMap = snaps;
        Api.SetSketches(all.Select(kv => Tuple.Create(kv.Key, kv.Value)).ToArray());
    }

    /// <summary>Replay the stored tree into a fresh kernel model.</summary>
    void Rebuild()
    {
        RegisterSketches();
        tree = new ProofTree();
        var t = Active;
        foreach (var n in t.Nodes)
        {
            n.Error = null;
            var e = n.IsRule
                ? tree.AddRule(n.Id, n.Premises.ToArray(), n.Conclusions.ToArray())
                : tree.AddStatement(n.Id, n.Conclusions.FirstOrDefault() ?? "", n.IsGiven);
            if (e.Length > 0) n.Error = e;
        }
        foreach (var w in t.Wires.OrderBy(w => w.Id))
            tree.Connect(w.Id, w.Src, w.SrcIdx, w.Dst, w.DstIdx);
        Refresh();
    }

    void Refresh()
    {
        report = tree.Report();
        jmap = report.Judgments.ToDictionary(j => (j.Node, j.Index, j.IsPremise), j => j);
        badWires = report.BadWires.GroupBy(b => b.Wire).ToDictionary(g => g.Key, g => g.First().Message);
        establishedPorts = report.Established.Select(p => (p.Node, p.Index)).ToHashSet();
        provenNodes = report.Proven.Select(p => p.Node).ToHashSet();
        wiredPremises = Active.Wires.Select(w => (w.Dst, w.DstIdx)).ToHashSet();
        needMeasure = true;
    }

