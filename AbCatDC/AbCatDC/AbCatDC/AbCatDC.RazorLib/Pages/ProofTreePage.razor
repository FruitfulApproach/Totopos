    static string QuiverSrc(string json, bool embed)
    {
        var t = (json ?? "").Trim();
        var b64 = t.StartsWith("[") ? Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(t)) : t;
        return "_content/AbCatDC.RazorLib/quiver/index.html#q=" + b64 + (embed ? "&embed" : "");
    }

    static string StmtTitle(TreeNodeDto n) =>
        n.Role == "given" ? "a given — established by assumption" : "drop a conclusion on the top dot to establish this; drag the bottom dot to use it";

    /// <summary>The tree's own copy of a diagram (a system diagram is copied on first edit, so the system stays as it was).</summary>
    SketchDto OwnSketch(string name)
    {
        var own = Active.Sketches.FirstOrDefault(s => s.Name == name);
        if (own is not null) return own;
        var sysSk = sys.Sketches.FirstOrDefault(s => s.Name == name);
        own = new SketchDto { Name = name, Json = sysSk?.Json ?? "", Snapshot = sysSk?.Snapshot };
        Active.Sketches.Add(own);
        return own;
    }

    void OpenSketchModal(string name)
    {
        if (!sketchMap.TryGetValue(name, out var json)) return;
        modalSketch = name;
        modalEditing = false;
        renamingSketch = false;
        snapNote = null;
        modalSrc = QuiverSrc(json, true);
    }

    void StartModalEdit()
    {
        if (modalSketch is null || !sketchMap.TryGetValue(modalSketch, out var json)) return;
        modalEditing = true;
        modalSrc = QuiverSrc(json, false);
        teachPending = SnapshotSvc is not null;
    }

    /// <summary>The camera on a flagged preview: straight into the editor for that sketch.</summary>
    void OpenSketchForSnapshot(string name)
    {
        if (!sketchMap.TryGetValue(name, out var json)) return;
        modalSketch = name;
        renamingSketch = false;
        snapNote = null;
        modalEditing = true;
        modalSrc = QuiverSrc(json, false);
        teachPending = SnapshotSvc is not null;
    }

