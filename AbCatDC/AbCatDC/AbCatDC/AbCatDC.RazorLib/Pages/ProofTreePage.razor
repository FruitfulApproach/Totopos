    // ------------------------------------------------------------ nodes
    (double x, double y) NextSpot()
    {
        var k = Active.Nodes.Count;
        return (40 + 36 * (k % 8), 40 + 36 * (k % 8) + 120 * (k / 8));
    }

    async Task AddRuleNode()
    {
        if (selRuleIdx < 0 || selRuleIdx >= sys.Rules.Count) return;
        var r = sys.Rules[selRuleIdx];
        var (x, y) = NextSpot();
        var n = new TreeNodeDto
        {
            Id = Active.NextId++, IsRule = true, Role = "rule",
            RuleName = string.IsNullOrWhiteSpace(r.Name) ? $"{r.Kind} rule" : r.Name, RuleKind = r.Kind,
            Premises = r.Premises.ToList(), Conclusions = r.Conclusions.ToList(), X = x, Y = y
        };
        var e = tree.AddRule(n.Id, n.Premises.ToArray(), n.Conclusions.ToArray());
        if (e.Length > 0) { toast = $"{n.RuleName}: {e}"; return; }
        Active.Nodes.Add(n);
        toast = null;
        Refresh();
        await Save();
    }

    async Task AddStatementNode(string text)
    {
        var line = (text ?? "").Trim();
        if (line.Length == 0) return;
        var (x, y) = NextSpot();
        var id = Active.NextId;
        var e = tree.AddStatement(id, line, stmtRole == "given");
        if (e.Length > 0) { toast = e; return; }
        Active.NextId++;
        Active.Nodes.Add(new TreeNodeDto { Id = id, IsRule = false, Role = stmtRole, Premises = new() { line }, Conclusions = new() { line }, X = x, Y = y });
        stmtInput = "";
        toast = null;
        Refresh();
        await Save();
    }

    async Task RemoveNode(int id)
    {
        tree.Remove(id);
        Active.Nodes.RemoveAll(n => n.Id == id);
        Active.Wires.RemoveAll(w => w.Src == id || w.Dst == id);
        if (selectedWire is int s && Active.Wires.All(w => w.Id != s)) selectedWire = null;
        Refresh();
        await Save();
    }

    async Task CycleRole(TreeNodeDto n)
    {
        n.Role = n.Role switch { "given" => "goal", "goal" => "lemma", _ => "given" };
        Rebuild();
        await Save();
    }

