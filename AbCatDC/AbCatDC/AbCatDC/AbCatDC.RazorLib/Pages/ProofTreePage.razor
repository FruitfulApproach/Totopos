    async Task ModalDone()
    {
        if (modalSketch is null) return;
        try { await JS.InvokeVoidAsync("abEditor.teachOff"); } catch { }
        if (modalEditing)
        {
            var b64 = "";
            try { b64 = await JS.InvokeAsync<string>("abEditor.readQuiverFrame", "pt-sketch-frame"); } catch { }
            if (!string.IsNullOrEmpty(b64))
            {
                var own = OwnSketch(modalSketch);
                own.Json = QuiverImport.NormalizePositions(b64);
                Rebuild();
                await Save();
            }
        }
        modalSketch = null;
        modalEditing = false;
        renamingSketch = false;
    }

    async Task TakeTreeSnapshot()
    {
        var svc = SnapshotSvc;
        if (svc is null || snapBusy || modalSketch is null) return;
        snapBusy = true;
        snapNote = null;
        try
        {
            var b64 = await svc.CapturePngBase64Async();
            var url = string.IsNullOrEmpty(b64) ? "" : await JS.InvokeAsync<string>("abEditor.cropSnapshot", b64, "pt-sketch-frame", 900);
            if (string.IsNullOrEmpty(url)) snapNote = "could not capture";
            else
            {
                OwnSketch(modalSketch).Snapshot = url;
                RegisterSketches();
                await Save();
                snapNote = "stored";
                try { await JS.InvokeVoidAsync("abEditor.teachOff"); } catch { }
                _ = ShowSnapToast(url);
            }
        }
        catch (Exception ex) { snapNote = "capture failed: " + ex.Message; }
        snapBusy = false;
    }

    async Task OnRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CommitRename();
        else if (e.Key == "Escape") renamingSketch = false;
    }

    /// <summary>Rename a diagram throughout the tree: its sketch entry and every [old] reference in the nodes.</summary>
    async Task CommitRename()
    {
        if (modalSketch is null) return;
        var nm = sketchNameEdit.Trim();
        var valid = nm.Length > 0 && char.IsLetter(nm[0]) && nm.All(c => char.IsLetterOrDigit(c) || c == '_' || c == '-' || "₀₁₂₃₄₅₆₇₈₉".Contains(c)) && nm[^1] != '-';
        if (!valid) { renameError = "letters/digits/underscore/hyphen, starting with a letter"; return; }
        if (nm != modalSketch && sketchMap.ContainsKey(nm)) { renameError = "that name is taken"; return; }
        if (nm != modalSketch)
        {
            var own = OwnSketch(modalSketch);
            own.Name = nm;
            foreach (var n in Active.Nodes)
            {
                for (var i = 0; i < n.Premises.Count; i++) n.Premises[i] = n.Premises[i].Replace("[" + modalSketch + "]", "[" + nm + "]");
                for (var i = 0; i < n.Conclusions.Count; i++) n.Conclusions[i] = n.Conclusions[i].Replace("[" + modalSketch + "]", "[" + nm + "]");
            }
            modalSketch = nm;
            Rebuild();
            await Save();
            if (sketchMap.TryGetValue(nm, out var json)) modalSrc = QuiverSrc(json, modalEditing ? false : true);
        }
        renamingSketch = false;
        renameError = null;
    }

    // ------------------------------------------------------------ layout
    (double w, double h) SizeOf(int id) =>
        rects.TryGetValue(id, out var r) && r.W > 0 ? (r.W, r.H) : (280, 96);

    bool Overlaps(TreeNodeDto n, double x, double y, double w, double h)
    {
        var (nw, nh) = SizeOf(n.Id);
        const double m = 18;
        return !(x + w + m <= n.X || n.X + nw + m <= x || y + h + m <= n.Y || n.Y + nh + m <= y);
    }

    /// <summary>A spot for a new node next to its anchor — above it for a backward step, below for a forward one —
    /// slid sideways until it overlaps nothing already on the canvas.</summary>
    (double x, double y) PlaceNew(int anchorId, bool above, int slot)
    {
        var a = Active.Nodes.FirstOrDefault(n => n.Id == anchorId);
        var ax = a?.X ?? 40;
        var ay = a?.Y ?? 40;
        var (aw, ah) = a is null ? (280.0, 96.0) : SizeOf(a.Id);
        const double w = 280, h = 96, gap = 44;
        var y = above ? ay - h - gap : ay + ah + gap;
        var x = ax + 40 * Math.Max(0, slot - 1);
        if (y < 0)
        {
            var dy = -y + 40;
            foreach (var n in Active.Nodes) n.Y += dy;
            y = 40;
        }
        for (var guard = 0; guard < 60; guard++)
        {
            var hit = Active.Nodes.FirstOrDefault(n => Overlaps(n, x, y, w, h));
            if (hit is null) break;
            x = hit.X + SizeOf(hit.Id).w + gap;
        }
        return (x, y);
    }

    /// <summary>Layered layout: sinks (goals) at the bottom, each node one layer above the nodes it feeds; within a
    /// layer nodes are ordered by the mean position of what they feed.</summary>
    async Task AutoLayout()
    {
        var nodes = Active.Nodes;
        if (nodes.Count == 0) return;
        var ids = nodes.Select(n => n.Id).ToHashSet();
        var wires = Active.Wires.Where(w => ids.Contains(w.Src) && ids.Contains(w.Dst) && !badWires.ContainsKey(w.Id)).ToList();
        var outOf = nodes.ToDictionary(n => n.Id, n => wires.Where(w => w.Src == n.Id).Select(w => w.Dst).Distinct().ToList());
        var layer = new Dictionary<int, int>();
        int LayerOf(int id, HashSet<int> visiting)
        {
            if (layer.TryGetValue(id, out var l)) return l;
            if (!visiting.Add(id)) return 0;
            var below = outOf[id];
            var v = below.Count == 0 ? 0 : 1 + below.Max(d => LayerOf(d, visiting));
            visiting.Remove(id);
            layer[id] = v;
            return v;
        }
        foreach (var n in nodes) LayerOf(n.Id, new HashSet<int>());
        var layers = nodes.GroupBy(n => layer[n.Id]).OrderBy(g => g.Key).ToDictionary(g => g.Key, g => g.ToList());
        var order = nodes.ToDictionary(n => n.Id, n => n.X);
        for (var sweep = 0; sweep < 3; sweep++)
            foreach (var kv in layers.OrderBy(kv => kv.Key))
            {
                if (kv.Key == 0) continue;
                foreach (var n in kv.Value)
                {
                    var below = outOf[n.Id];
                    if (below.Count > 0) order[n.Id] = below.Average(d => order[d]);
                }
            }
        const double gapX = 48, gapY = 70;
        var rowHeights = layers.ToDictionary(kv => kv.Key, kv => kv.Value.Max(n => SizeOf(n.Id).h));
        var maxL = layers.Keys.Max();
        var y = 40.0;
        var yOf = new Dictionary<int, double>();
        for (var l = maxL; l >= 0; l--)
        {
            yOf[l] = y;
            if (layers.ContainsKey(l)) y += rowHeights[l] + gapY;
        }
        var widths = layers.ToDictionary(kv => kv.Key, kv => kv.Value.Sum(n => SizeOf(n.Id).w) + gapX * (kv.Value.Count - 1));
        var maxW = widths.Values.Max();
        foreach (var kv in layers)
        {
            var x = 40 + (maxW - widths[kv.Key]) / 2;
            foreach (var n in kv.Value.OrderBy(n => order[n.Id]).ThenBy(n => n.Id))
            {
                n.X = x;
                n.Y = yOf[kv.Key];
                x += SizeOf(n.Id).w + gapX;
            }
        }
        needMeasure = true;
        await Save();
    }

    // ------------------------------------------------------------ geometry & colour
    (double x, double y)? PortPos(int node, int idx, bool premise)
    {
        return ports.TryGetValue($"{node}:{(premise ? "p" : "c")}:{idx}", out var m)
            ? (m.X, premise ? m.Top : m.Bottom)
            : null;
    }

    static string Bezier((double x, double y) a, (double x, double y) b)
    {
        var d = Math.Clamp(Math.Abs(b.y - a.y) / 2, 40, 160);
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        return string.Format(inv, "M {0:0.#} {1:0.#} C {0:0.#} {2:0.#}, {3:0.#} {4:0.#}, {3:0.#} {5:0.#}", a.x, a.y, a.y + d, b.x, b.y - d, b.y);
    }

    TreeJudgment? Judgment(int node, int idx, bool premise) =>
        jmap.TryGetValue((node, idx, premise), out var j) ? j : null;

    static double Hue(int c) => (c * 137.508) % 360;

    static string ChipStyle(TreeJudgment? j)
    {
        if (j is null) return "";
        var h = Hue(j.Class).ToString("0", System.Globalization.CultureInfo.InvariantCulture);
        return $"background: hsl({h} 70% 88%); border-color: hsl({h} 55% 45%); color: #1c1e26";
    }

    static string SwatchStyle(int c)
    {
        var h = Hue(c).ToString("0", System.Globalization.CultureInfo.InvariantCulture);
        return $"background: hsl({h} 70% 80%); border-color: hsl({h} 55% 45%)";
    }
}
