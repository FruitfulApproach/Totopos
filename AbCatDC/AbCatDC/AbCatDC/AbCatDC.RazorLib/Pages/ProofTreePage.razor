@page "/tree"
@using AbCatDC.Kernel
@using System.Text.Json
@inject IJSRuntime JS
@inject IServiceProvider Services
@implements IDisposable

<div class="pt-page">
    @if (topOpen)
    {
        <div class="pt-top">
            <div class="pt-toolbar">
                <div class="pt-tool-group">
                    <span class="pt-tool-label"><i class="fa-solid fa-folder-open"></i> Tree</span>
                    <select class="ab-text-input pt-select" value="@blob.Active" @onchange="OnTreeSelected">
                        @foreach (var t in blob.Trees)
                        {
                            <option value="@t.Name">@t.Name</option>
                        }
                    </select>
                    <button type="button" class="ab-kind-btn" @onclick="NewTree" title="new tree"><i class="fa-solid fa-plus"></i></button>
                    <button type="button" class="ab-kind-btn" @onclick="() => renaming = !renaming" title="rename"><i class="fa-solid fa-i-cursor"></i></button>
                    <button type="button" class="ab-kind-btn danger" @onclick="DeleteTree" title="delete tree"><i class="fa-solid fa-trash-can"></i></button>
                    <button type="button" class="ab-kind-btn danger" disabled="@(Active.Nodes.Count == 0)" @onclick="ClearTree" title="remove every node"><i class="fa-solid fa-eraser"></i></button>
                </div>
                <div class="pt-tool-group">
                    <span class="pt-tool-label"><i class="fa-solid fa-flag-checkered"></i> Example</span>
                    <select class="ab-text-input pt-select" value="@selExample" @onchange="e => selExample = int.TryParse(e.Value?.ToString(), out var v) ? v : -1">
                        <option value="-1">— a goal with its proof in progress —</option>
                        @for (var i = 0; i < ExampleTrees.All.Length; i++)
                        {
                            <option value="@i">@ExampleTrees.All[i].Name</option>
                        }
                    </select>
                    <button type="button" class="ab-btn-primary sm" disabled="@(selExample < 0)" @onclick="LoadExample"><i class="fa-solid fa-download"></i> Load</button>
                </div>
                <div class="pt-tool-group">
                    <span class="pt-tool-label"><i class="fa-solid fa-scale-balanced"></i> Rule</span>
                    <select class="ab-text-input pt-select" value="@selRuleIdx" @onchange="e => selRuleIdx = int.TryParse(e.Value?.ToString(), out var v) ? v : -1">
                        <option value="-1">— choose a rule —</option>
                        @foreach (var k in SystemStore.Kinds)
                        {
                            var group = sys.Rules.Select((r, i) => (r, i)).Where(t => t.r.Kind == k).ToList();
                            if (group.Count == 0) { continue; }
                            <optgroup label="@k">
                                @foreach (var (r, i) in group)
                                {
                                    <option value="@i">@(string.IsNullOrWhiteSpace(r.Name) ? $"({k} rule {i + 1})" : r.Name)</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <button type="button" class="ab-btn-primary sm" disabled="@(selRuleIdx < 0)" @onclick="AddRuleNode"><i class="fa-solid fa-plus"></i> Add rule</button>
                </div>
                <div class="pt-tool-group pt-stmt">
                    <span class="pt-tool-label"><i class="fa-solid fa-quote-left"></i></span>
                    <select class="ab-text-input pt-select pt-role" value="@stmtRole" @onchange="OnRoleChanged">
                        <option value="given">given</option>
                        <option value="goal">goal</option>
                        <option value="lemma">lemma</option>
                    </select>
                    <div class="pt-stmt-editor">
                        <SymbolEditor Id="tree-stmt" Rows="1" ShowPad="false" SubmitOnEnter="true"
                                      Placeholder="a statement, e.g. Γ ⊢ f : A → B — Enter adds it"
                                      Value="@stmtInput" ValueChanged="v => stmtInput = v" OnSubmit="AddStatementNode" />
                    </div>
                </div>
                <div class="pt-tool-group">
                    <button type="button" class="ab-kind-btn" @onclick="() => SetZoomFromUi(zoom / 1.1)" title="zoom out (Ctrl + wheel)"><i class="fa-solid fa-magnifying-glass-minus"></i></button>
                    <button type="button" class="ab-kind-btn" @onclick="() => SetZoomFromUi(1)" title="reset zoom to 100% (Ctrl + wheel zooms about the cursor)">@((int)Math.Round(zoom * 100))%</button>
                    <button type="button" class="ab-kind-btn" @onclick="() => SetZoomFromUi(zoom * 1.1)" title="zoom in (Ctrl + wheel)"><i class="fa-solid fa-magnifying-glass-plus"></i></button>
                    <button type="button" class="ab-kind-btn" @onclick="AutoLayout" disabled="@(Active.Nodes.Count == 0)" title="lay the tree out in layers"><i class="fa-solid fa-diagram-project"></i> Auto-layout</button>
                    <button type="button" class="ab-kind-btn" @onclick="() => helpOpen = !helpOpen" title="how to use this page"><i class="fa-solid fa-circle-question"></i></button>
                </div>
            </div>
            @if (renaming)
            {
                <div class="pt-toolbar">
                    <input class="ab-text-input" style="max-width:20rem; margin:0" value="@renameText"
                           @oninput="e => renameText = e.Value?.ToString() ?? string.Empty" />
                    <button type="button" class="ab-kind-btn" @onclick="ApplyRename">OK</button>
                </div>
            }
            @if (toast is not null)
            {
                <div class="ab-error" style="margin:.4rem 0 0">@toast <button type="button" class="ab-link-btn" @onclick="() => toast = null">dismiss</button></div>
            }
            @if (helpOpen)
            {
                <p class="ab-muted pt-help">
                    Bring rules onto the canvas and wire a conclusion into the premise it discharges: press anywhere on a
                    node to drag it; drag from the <b>dot under a conclusion</b> onto a <b>premise</b> to wire. Every
                    judgment is coloured by what it is up to substitution — same colour, same statement; a dashed chip
                    still has unbound metavariables. <b>Givens</b> are established by assumption, a <b>goal</b> is proven
                    once a wire from an established conclusion reaches it (✓). A proof is a DAG: a cycle is shown in red.
                    The search in the side panel works backward from open obligations and forward from what is
                    established; the panels collapse from the handles on their dividers.
                    @if (!string.IsNullOrEmpty(Active.Description)) { <br /><i>@Active.Description</i> }
                </p>
            }
        </div>
    }
    <div class="pt-hdivider" @onclick="() => { topOpen = !topOpen; needMeasure = true; }" title="@(topOpen ? "collapse the toolbar" : "expand the toolbar")">
        <span class="pt-grip"><i class="fa-solid @(topOpen ? "fa-chevron-up" : "fa-chevron-down")"></i> @(topOpen ? "" : Active.Name)</span>
    </div>

    <div class="pt-main">
        <div class="pt-canvas" id="pt-canvas" @onpointermove="OnMove" @onpointerup="OnUp" @onpointercancel="OnUp" @onpointerleave="OnLeave">
            <div class="pt-surface" id="pt-surface" style="width:@(Px(SurfaceW)); height:@(Px(SurfaceH)); zoom:@(ZoomText)">
                <svg class="pt-wires" width="@SurfaceW" height="@SurfaceH">
                    @foreach (var w in Active.Wires)
                    {
                        var a = PortPos(w.Src, w.SrcIdx, false);
                        var b = PortPos(w.Dst, w.DstIdx, true);
                        if (a is null || b is null) { continue; }
                        var cls = "pt-wire"
                            + (report.CycleWires.Contains(w.Id) ? " cycle" : "")
                            + (badWires.ContainsKey(w.Id) ? " bad" : "")
                            + (selectedWire == w.Id ? " sel" : "")
                            + (lastWires.Contains(w.Id) ? " fresh" : "");
                        <path d="@Bezier(a.Value, b.Value)" class="@cls" @onclick="() => selectedWire = w.Id" @onclick:stopPropagation>
                            @if (badWires.TryGetValue(w.Id, out var why)) { <title>@why</title> }
                        </path>
                        @if (selectedWire == w.Id)
                        {
                            var mx = (a.Value.x + b.Value.x) / 2;
                            var my = (a.Value.y + b.Value.y) / 2;
                            <g class="pt-wire-del" @onclick="() => RemoveWire(w.Id)" @onclick:stopPropagation>
                                <circle cx="@mx" cy="@my" r="9" />
                                <text x="@mx" y="@(my + 4)" text-anchor="middle">×</text>
                            </g>
                        }
                    }
                    @if (pendingSrc is not null)
                    {
                        <path d="@Bezier((pendingStartX, pendingStartY), (pendingX, pendingY))" class="pt-wire pending" />
                    }
                </svg>
                @foreach (var n in Active.Nodes)
                {
                    var onCycle = report.CycleNodes.Contains(n.Id);
                    var proven = provenNodes.Contains(n.Id);
                    var nodeCls = "pt-node " + (n.IsRule ? "rule" : "stmt " + n.Role)
                        + (onCycle ? " cycle" : "") + (n.Error is not null ? " broken" : "")
                        + (proven ? " proven" : "") + (lastNode == n.Id ? " fresh" : "");
                    <div class="@nodeCls" id="pt-node-@n.Id" data-node="@n.Id" style="left:@(Px(n.X)); top:@(Px(n.Y))" @key="n.Id"
                         @onpointerdown="e => StartDrag(n, e)" @ondblclick="OnNodeDblClick">
                        @if (!n.IsRule)
                        {
                            var sj = Judgment(n.Id, 0, false);
                            var sEst = establishedPorts.Contains((n.Id, 0));
                            var sWired = wiredPremises.Contains((n.Id, 0));
                            <div class="pt-ports single">
                                <div class="pt-chip stmtchip @(sEst ? "est" : "") @(sWired ? "wired" : "")" style="@ChipStyle(sj)"
                                     title="@StmtTitle(n)"
                                     @onpointerup="() => EndWire(n.Id, 0)" @onpointerup:stopPropagation>
                                    <span class="pt-dot in" data-port="@($"{n.Id}:p:0")"></span>
                                    @if (sEst) { <i class="fa-solid fa-check pt-est-mark"></i> }
                                    <InlineExpr Text="@(sj?.Text ?? n.Conclusions[0])" Sketches="sketchMap" Snapshots="snapshotMap" Height="56" OnOpen="OpenSketchModal" OnSnapshot="OpenSketchForSnapshot" />
                                    <span class="pt-dot out" data-port="@($"{n.Id}:c:0")" title="drag onto a premise to wire"
                                          @onpointerdown="e => StartWire(n.Id, 0, e)" @onpointerdown:stopPropagation @onpointerdown:preventDefault></span>
                                </div>
                            </div>
                        }
                        <div class="pt-ports top @(n.IsRule ? "" : "none")">
                            @for (var i = 0; n.IsRule && i < n.Premises.Count; i++)
                            {
                                var idx = i;
                                var j = Judgment(n.Id, idx, true);
                                var discharged = wiredPremises.Contains((n.Id, idx));
                                <div class="pt-chip prem @(j is { Ground: false } ? "open" : "") @(discharged ? "wired" : "")" style="@ChipStyle(j)"
                                     data-port="@($"{n.Id}:p:{idx}")" title="@PremTitle(n, idx)"
                                     @onpointerup="() => EndWire(n.Id, idx)" @onpointerup:stopPropagation>
                                    <span class="pt-dot in"></span><InlineExpr Text="@(j?.Text ?? n.Premises[idx])" Sketches="sketchMap" Snapshots="snapshotMap" Height="56" OnOpen="OpenSketchModal" OnSnapshot="OpenSketchForSnapshot" />
                                </div>
                            }
                            @if (n.IsRule && n.Premises.Count == 0)
                            {
                                <span class="pt-nopremise">(no premises)</span>
                            }
                        </div>
                        <div class="pt-bar">
                            <span class="pt-id">#@n.Id</span>
                            @if (n.IsRule)
                            {
                                <span class="pt-name">@n.RuleName</span>
                                <span class="pt-kind">@n.RuleKind</span>
                            }
                            else
                            {
                                <button type="button" class="pt-role-btn @n.Role" title="click to change the role: given → goal → lemma"
                                        @onclick="() => CycleRole(n)" @onpointerdown:stopPropagation>
                                    <i class="fa-solid @RoleIcon(n.Role)"></i> @n.Role
                                </button>
                                @if (proven) { <span class="pt-proven-badge" title="established"><i class="fa-solid fa-check"></i></span> }
                            }
                            <button type="button" class="pt-x" title="remove" @onclick="() => RemoveNode(n.Id)" @onpointerdown:stopPropagation>×</button>
                        </div>
                        @if (n.Error is not null)
                        {
                            <div class="pt-broken">@n.Error</div>
                        }
                        <div class="pt-ports bottom @(n.IsRule ? "" : "none")">
                            @for (var i = 0; n.IsRule && i < n.Conclusions.Count; i++)
                            {
                                var idx = i;
                                var j = Judgment(n.Id, idx, false);
                                var est = establishedPorts.Contains((n.Id, idx));
                                <div class="pt-chip concl @(j is { Ground: false } ? "open" : "") @(est ? "est" : "")" style="@ChipStyle(j)"
                                     data-port="@($"{n.Id}:c:{idx}")" title="@ConclTitle(est, idx)">
                                    @if (est) { <i class="fa-solid fa-check pt-est-mark"></i> }
                                    <InlineExpr Text="@(j?.Text ?? n.Conclusions[idx])" Sketches="sketchMap" Snapshots="snapshotMap" Height="56" OnOpen="OpenSketchModal" OnSnapshot="OpenSketchForSnapshot" /><span class="pt-dot out" title="drag onto a premise to wire"
                                         @onpointerdown="e => StartWire(n.Id, idx, e)" @onpointerdown:stopPropagation @onpointerdown:preventDefault></span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="pt-vdivider" id="pt-vdiv" title="drag to resize, click to collapse the panel"
             @onpointerdown="StartResize" @onpointermove="OnResizeMove" @onpointerup="EndResize" @onpointercancel="EndResize">
            <span class="pt-grip"><i class="fa-solid @(rightOpen ? "fa-chevron-right" : "fa-chevron-left")"></i></span>
        </div>

        @if (rightOpen)
        {
            <aside class="pt-context" style="width:@(Px(rightWidth))">
                @if (AllGoalsProven)
                {
                    <div class="pt-ctx-ok"><i class="fa-solid fa-circle-check"></i> Every goal is established.</div>
                }
                @if (report.CycleNodes.Length > 0)
                {
                    <div class="pt-ctx-error">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        A proof must be a DAG — nodes @string.Join(", ", report.CycleNodes.Select(i => "#" + i)) form a cycle. Remove one of the red wires.
                    </div>
                }
                @foreach (var b in report.BadWires)
                {
                    <div class="pt-ctx-error"><i class="fa-solid fa-triangle-exclamation"></i> wire: @b.Message</div>
                }
                @if (selectedWire is int sw && Active.Wires.Any(w => w.Id == sw))
                {
                    <button type="button" class="ab-kind-btn danger" style="margin-bottom:.5rem" @onclick="() => RemoveWire(sw)">
                        <i class="fa-solid fa-scissors"></i> Delete selected wire
                    </button>
                }

                <div class="pt-ctx-sec pt-search">
                    <div class="pt-ctx-title"><i class="fa-solid fa-magnifying-glass"></i> Automated search</div>
                    <div class="pt-search-row">
                        @if (!searching)
                        {
                            <button type="button" class="ab-btn-primary sm" disabled="@(sys.Rules.Count == 0 || Active.Nodes.Count == 0)" @onclick="StartSearch">
                                <i class="fa-solid fa-play"></i> Search
                            </button>
                        }
                        else
                        {
                            <button type="button" class="ab-kind-btn" @onclick="() => paused = !paused">
                                <i class="fa-solid @(paused ? "fa-play" : "fa-pause")"></i> @(paused ? "Resume" : "Pause")
                            </button>
                            <button type="button" class="ab-kind-btn danger" @onclick="StopSearch"><i class="fa-solid fa-stop"></i> Stop</button>
                        }
                    </div>
                    <label class="pt-check"><input type="checkbox" checked="@visualize" @onchange="e => visualize = e.Value is bool b && b" /> Visualize the search</label>
                    <label class="pt-slider @(visualize ? "" : "off")">
                        <span>Playback speed</span>
                        <input type="range" min="1" max="10" value="@speed" disabled="@(!visualize)" @oninput="e => speed = int.TryParse(e.Value?.ToString(), out var v) ? v : speed" />
                        <span class="pt-speed">@(visualize ? speed.ToString() : "full")</span>
                    </label>
                    <div class="ab-muted pt-status">@searchStatus</div>
                    @if (!string.IsNullOrEmpty(lastNote))
                    {
                        <div class="pt-note">@lastNote</div>
                    }
                </div>

                <div class="pt-ctx-sec">
                    <div class="pt-ctx-title">Obligations <span class="ab-muted">— premises nothing discharges</span></div>
                    @if (report.Open.Length == 0) { <div class="ab-muted">none</div> }
                    @foreach (var p in report.Open)
                    {
                        <div class="pt-ctx-row"><span class="pt-ctx-node">#@p.Node</span><span>@p.Text</span></div>
                    }
                </div>

                <div class="pt-ctx-sec">
                    <div class="pt-ctx-title">Established <span class="ab-muted">— @report.Established.Length conclusion@(report.Established.Length == 1 ? "" : "s")</span></div>
                    @foreach (var p in report.Proven)
                    {
                        <div class="pt-ctx-row"><span class="pt-ctx-node">#@p.Node ✓</span><span>@p.Text</span></div>
                    }
                </div>

                <div class="pt-ctx-sec">
                    <div class="pt-ctx-title">Bindings <span class="ab-muted">— what the wiring determined</span></div>
                    @if (report.Bindings.Length == 0)
                    {
                        <div class="ab-muted">nothing bound yet</div>
                    }
                    @foreach (var g in report.Bindings.GroupBy(b => b.Node))
                    {
                        <div class="pt-ctx-row">
                            <span class="pt-ctx-node">#@g.Key @NodeName(g.Key)</span>
                            <span>@string.Join(",  ", g.Select(b => $"{b.Meta} ≔ {b.Value}"))</span>
                        </div>
                    }
                </div>

                <div class="pt-ctx-sec">
                    <div class="pt-ctx-title">Colours</div>
                    <div class="ab-muted">@report.ClassCount distinct judgment@(report.ClassCount == 1 ? "" : "s") up to substitution.</div>
                    <div class="pt-legend">
                        @for (var c = 0; c < Math.Min(report.ClassCount, 24); c++)
                        {
                            <span class="pt-swatch" style="@SwatchStyle(c)" title="class @(c + 1)"></span>
                        }
                    </div>
                </div>
            </aside>
        }
    </div>
</div>

@if (modalSketch is not null)
{
    <div class="ab-sketch-overlay pt-modal">
        <div class="pt-modal-head">
            <span class="pt-modal-label"><i class="fa-solid fa-compass-drafting"></i> Diagram</span>
            @if (renamingSketch)
            {
                <input class="ab-text-input pt-xedit-input" value="@sketchNameEdit" autofocus
                       @oninput="e => sketchNameEdit = e.Value?.ToString() ?? string.Empty"
                       @onkeydown="OnRenameKey" />
                <button type="button" class="ab-kind-btn" @onclick="CommitRename">OK</button>
                <button type="button" class="ab-kind-btn" @onclick="() => renamingSketch = false">Cancel</button>
                @if (renameError is not null) { <span class="ab-error" style="margin:0 .5rem">@renameError</span> }
            }
            else
            {
                <button type="button" class="pt-xedit" title="click to rename the diagram" @onclick="() => { renamingSketch = true; sketchNameEdit = modalSketch; renameError = null; }">
                    [@modalSketch] <i class="fa-solid fa-pen-to-square"></i>
                </button>
            }
            @if (modalEditing)
            {
                <span class="ab-muted">Draw, press quiver's <strong>Save</strong> (Ctrl+S), then the check to bring it back.</span>
                @if (SnapshotSvc is not null)
                {
                    <button type="button" id="pt-snap-btn" class="ab-kind-btn ab-snap-btn" @onclick="TakeTreeSnapshot" disabled="@snapBusy"
                            title="Store a picture of the diagram as drawn; previews then show it instead of a live quiver frame">
                        <i class="fa-solid fa-camera"></i> @(snapBusy ? "…" : "Snapshot")
                    </button>
                    @if (snapNote is not null) { <span class="ab-snap-note">@snapNote</span> }
                }
            }
            else
            {
                <span class="ab-muted">hover the picture for the pencil; the check closes</span>
            }
        </div>
        @if (modalEditing)
        {
            <iframe id="pt-sketch-frame" class="ab-sketch-frame pt-modal-frame" src="@modalSrc" title="quiver editor"></iframe>
        }
        else
        {
            <div class="pt-modal-view">
                @if (snapshotMap.TryGetValue(modalSketch, out var snapUrl))
                {
                    <img class="pt-modal-snap" src="@snapUrl" alt="[@modalSketch]" />
                }
                else
                {
                    <div class="pt-modal-nosnap">
                        <i class="fa-solid fa-camera"></i>
                        <div>No snapshot yet for <b>[@modalSketch]</b>. Press the pencil to open the editor, position the diagram, and take one.</div>
                    </div>
                }
                <button type="button" class="pt-modal-pencil" title="edit this diagram" @onclick="StartModalEdit">
                    <i class="fa-solid fa-pencil"></i>
                </button>
            </div>
        }
        <button type="button" class="ab-sketch-done" title="@(modalEditing ? "Done — import the diagram and close" : "Done")" @onclick="ModalDone">
            <svg viewBox="0 0 24 24" width="26" height="26" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 12.5 L9.5 18 L20 6.5" fill="none" stroke="currentColor" stroke-width="3"
                      stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
    </div>
}

@if (snapToast is not null)
{
    <div class="ab-snap-toast"><img src="@snapToast" alt="snapshot" /><span><i class="fa-solid fa-check"></i> snapshot stored</span></div>
}

@code {
    class PortMeasure
    {
        public string Key { get; set; } = "";
        public double X { get; set; }
        public double Top { get; set; }
        public double Bottom { get; set; }
    }

    class NodeRect
    {
        public int Id { get; set; }
        public double W { get; set; }
        public double H { get; set; }
    }

    const string StoreKey = "abcatdc-trees";

    // helpers installed once into the page: port positions and node sizes relative to the surface, pointer capture
    const string TreeJs = @"window.abTree = { measure: function (id, k) {
        var s = document.getElementById(id); if (!s) return [];
        k = k || 1;
        var r = s.getBoundingClientRect(); var out = [];
        s.querySelectorAll('[data-port]').forEach(function (el) {
            var b = el.getBoundingClientRect();
            out.push({ key: el.getAttribute('data-port'), x: (b.left + b.width / 2 - r.left) / k, top: (b.top - r.top) / k, bottom: (b.bottom - r.top) / k });
        });
        return out; },
      nodes: function (id, k) {
        var s = document.getElementById(id); if (!s) return [];
        k = k || 1;
        var out = [];
        s.querySelectorAll('[data-node]').forEach(function (el) {
            var b = el.getBoundingClientRect();
            out.push({ id: parseInt(el.getAttribute('data-node')), w: b.width / k, h: b.height / k });
        });
        return out; },
      wheelZoom: function (canvasId, surfaceId, ref) {
        var c = document.getElementById(canvasId); if (!c || c.__abZoom) return; c.__abZoom = true;
        c.addEventListener('wheel', function (e) {
            if (!e.ctrlKey) return;
            e.preventDefault();
            var s = document.getElementById(surfaceId); if (!s) return;
            var k = parseFloat(s.style.zoom || '1') || 1;
            var k2 = Math.min(3, Math.max(0.25, k * (e.deltaY < 0 ? 1.1 : 1 / 1.1)));
            var cr = c.getBoundingClientRect();
            var px = (c.scrollLeft + e.clientX - cr.left) / k;
            var py = (c.scrollTop + e.clientY - cr.top) / k;
            s.style.zoom = k2;
            c.scrollLeft = px * k2 - (e.clientX - cr.left);
            c.scrollTop = py * k2 - (e.clientY - cr.top);
            ref.invokeMethodAsync('SetZoom', k2);
        }, { passive: false }); },
      setZoom: function (canvasId, surfaceId, k2) {
        var c = document.getElementById(canvasId); var s = document.getElementById(surfaceId); if (!c || !s) return;
        var k = parseFloat(s.style.zoom || '1') || 1;
        var cr = c.getBoundingClientRect();
        var px = (c.scrollLeft + cr.width / 2) / k, py = (c.scrollTop + cr.height / 2) / k;
        s.style.zoom = k2;
        c.scrollLeft = px * k2 - cr.width / 2; c.scrollTop = py * k2 - cr.height / 2; },
      sketchAt: function (x, y) {
        var el = document.elementFromPoint(x, y);
        var w = el && el.closest ? el.closest('[data-sketch]') : null;
        return w ? w.getAttribute('data-sketch') : ''; },
      capture: function (id, pid) {
        var el = document.getElementById(id);
        if (el && el.setPointerCapture) { try { el.setPointerCapture(pid); } catch (e) { } } } };";

