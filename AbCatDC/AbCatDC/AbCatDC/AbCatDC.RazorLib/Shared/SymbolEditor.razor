@using AbCatDC.RazorLib.Services
@inject IJSRuntime JS
@inject AppSettingsService Settings
@implements IAsyncDisposable

<div class="ab-se">
    @if (ShowPad)
    {
        <div class="ab-symbol-pad">
            @foreach (var s in PadSymbols)
            {
                var sym = s;
                <button type="button" class="ab-symbol-btn" title="Insert @sym" tabindex="-1"
                        @onclick="() => InsertSymbol(sym)">@sym</button>
            }
        </div>
    }
    <div class="ab-editor-wrap">
        <textarea id="@Id" class="ab-editor @(Rows <= 1 ? "single" : "")" rows="@Rows" spellcheck="false"
                  placeholder="@Placeholder" value="@text" @oninput="OnInputEvt"></textarea>

        @if (popupOpen && popupItems.Count > 0)
        {
            <div class="ab-popup">
                @for (var i = 0; i < popupItems.Count; i++)
                {
                    var idx = i;
                    var item = popupItems[i];
                    <div class="ab-popup-item @(idx == popupIndex ? "sel" : "")"
                         @onmousedown="() => ApplyItem(idx)" @onmousedown:preventDefault
                         @onmouseover="() => popupIndex = idx">
                        <span class="ab-popup-sym">@item.Symbol</span>
                        <span class="ab-popup-cmd">\@item.Command</span>
                    </div>
                }
                <div class="ab-popup-hint">↑ ↓ navigate &nbsp;·&nbsp; Enter / Tab insert &nbsp;·&nbsp; Esc close</div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    /// <summary>Fires on Enter (without Shift) when SubmitOnEnter is set — e.g. to add a tag.</summary>
    [Parameter] public EventCallback<string> OnSubmit { get; set; }
    [Parameter] public int Rows { get; set; } = 4;
    [Parameter] public bool ShowPad { get; set; } = true;
    [Parameter] public bool SubmitOnEnter { get; set; }
    [Parameter] public string Placeholder { get; set; } = "";

    static readonly string[] PadSymbols =
    {
        "⊢", "Γ", "Δ", "→", "×", "+", "∩", "∪", "⟨", "⟩", "∀", "∃", "μ", "⋂", "⋃",
        "(", ")", ".", ":", ",", "^", "α", "β", "γ", "ρ", "σ", "τ", "ℕ", "ℤ"
    };

    private class EditorState
    {
        public string Text { get; set; } = "";
        public int Cursor { get; set; }
    }

    string text = "";
    bool attached;
    DotNetObjectReference<SymbolEditor>? selfRef;
    CancellationTokenSource? debounceCts;

    bool popupOpen;
    List<SymbolCommands.Entry> popupItems = new();
    int popupIndex;
    int inputGen;   // guards against interleaved async input handlers

    protected override async Task OnParametersSetAsync()
    {
        if (Value != text)
        {
            text = Value;
            if (attached)
                await JS.InvokeVoidAsync("abEditor.setValue", Id, text);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("abEditor.attach", Id, selfRef, SubmitOnEnter);
            await Settings.EnsureLoadedAsync();
            attached = true;
        }
    }

    Task Push() => ValueChanged.InvokeAsync(text);

    async Task OnInputEvt(ChangeEventArgs e)
    {
        var gen = ++inputGen;
        text = e.Value?.ToString() ?? "";
        await Push();
        var st = await JS.InvokeAsync<EditorState>("abEditor.getState", Id);
        if (gen != inputGen) return; // a newer keystroke supersedes this handler
        await AfterTextChanged(st.Text, st.Cursor, gen);
    }

    async Task AfterTextChanged(string t, int cursor, int gen)
    {
        debounceCts?.Cancel();
        var (start, prefix) = SymbolCommands.FindContext(t, cursor);
        if (start >= 0 && prefix.Length > 0)
        {
            var matches = SymbolCommands.Matches(prefix);
            if (matches.Count == 1)
            {
                if (gen != inputGen) return;
                // unique prefix — replace immediately ("match early")
                var st = await JS.InvokeAsync<EditorState>("abEditor.replaceRange", Id, start, cursor, matches[0].Symbol);
                if (gen == inputGen)
                {
                    text = st.Text;
                    await Push();
                }
                await ClosePopup();
                return;
            }
            if (matches.Count > 1)
            {
                var cts = debounceCts = new CancellationTokenSource();
                _ = OpenPopupAfterDelay(Settings.CompletionDelayMs, cts.Token, matches);
                return;
            }
        }
        await ClosePopup();
    }

    async Task OpenPopupAfterDelay(int ms, CancellationToken token, List<SymbolCommands.Entry> matches)
    {
        try { await Task.Delay(ms, token); }
        catch (TaskCanceledException) { return; }
        if (token.IsCancellationRequested) return;
        await InvokeAsync(async () =>
        {
            await OpenPopup(matches);
            StateHasChanged();
        });
    }

    async Task OpenPopup(List<SymbolCommands.Entry> items)
    {
        popupItems = items;
        popupIndex = 0;
        popupOpen = true;
        await JS.InvokeVoidAsync("abEditor.setPopupOpen", Id, true);
    }

    async Task ClosePopup()
    {
        if (!popupOpen) return;
        popupOpen = false;
        await JS.InvokeVoidAsync("abEditor.setPopupOpen", Id, false);
    }

    async Task ApplyItem(int idx)
    {
        if (idx < 0 || idx >= popupItems.Count) return;
        var sym = popupItems[idx].Symbol;
        // revalidate against the live caret — stored offsets go stale when the
        // caret moves without an input event
        var cur = await JS.InvokeAsync<EditorState>("abEditor.getState", Id);
        var (start, _) = SymbolCommands.FindContext(cur.Text, cur.Cursor);
        var st = start >= 0
            ? await JS.InvokeAsync<EditorState>("abEditor.replaceRange", Id, start, cur.Cursor, sym)
            : await JS.InvokeAsync<EditorState>("abEditor.insertAtCursor", Id, sym);
        text = st.Text;
        await Push();
        await ClosePopup();
    }

    [JSInvokable]
    public async Task OnEditorKey(string key, int cursor, string curText)
    {
        text = curText;
        switch (key)
        {
            case "Submit":
                debounceCts?.Cancel();
                await ClosePopup();
                await Push();
                await OnSubmit.InvokeAsync(text);
                break;
            case "CtrlSpace":
                debounceCts?.Cancel();
                var (start, prefix) = SymbolCommands.FindContext(curText, cursor);
                if (start >= 0)
                {
                    var matches = SymbolCommands.Matches(prefix);
                    if (matches.Count > 0) await OpenPopup(matches);
                    else await ClosePopup();
                }
                else
                {
                    // no \command context: offer the full palette, plain insert
                    await OpenPopup(SymbolCommands.All.ToList());
                }
                await Push();
                break;
            case "ArrowDown":
                if (popupItems.Count > 0) popupIndex = (popupIndex + 1) % popupItems.Count;
                break;
            case "ArrowUp":
                if (popupItems.Count > 0) popupIndex = (popupIndex - 1 + popupItems.Count) % popupItems.Count;
                break;
            case "Enter":
            case "Tab":
                await ApplyItem(popupIndex);
                break;
            case "Escape":
            case "CloseOnly":
                await ClosePopup();
                break;
        }
        StateHasChanged();
    }

    async Task InsertSymbol(string s)
    {
        var st = await JS.InvokeAsync<EditorState>("abEditor.insertAtCursor", Id, s);
        text = st.Text;
        await Push();
        await ClosePopup();
    }

    public async ValueTask DisposeAsync()
    {
        debounceCts?.Cancel();
        debounceCts?.Dispose();
        selfRef?.Dispose();
        await Task.CompletedTask;
    }
}
