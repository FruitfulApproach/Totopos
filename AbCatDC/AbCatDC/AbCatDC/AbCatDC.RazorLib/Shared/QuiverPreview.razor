@using AbCatDC.Kernel

<div class="ab-qprev" style="min-height: @(Height)px">
    @if (!parsed.Ok)
    {
        <div class="ab-qprev-msg ab-muted">@(string.IsNullOrWhiteSpace(Json) ? "No diagram yet — paste quiver JSON or load the example." : parsed.Error)</div>
    }
    else if (parsed.Graph.VertexCount == 0)
    {
        <div class="ab-qprev-msg ab-muted">Empty diagram.</div>
    }
    else
    {
        @* quiver's native read-only embed mode: real KaTeX labels, arrow styles, higher cells.
           native onload (not a Blazor event) flips the loading spinner off without a re-render *@
        <span class="ab-frame-wrap" style="height: @(Height)px">
            <iframe class="ab-qprev-frame" src="@embedSrc" style="height: @(Height)px"
                    title="quiver diagram preview" loading="lazy"
                    onload="this.parentElement.classList.add('ab-loaded')"></iframe>
        </span>
    }

    <button type="button" class="ab-qprev-edit" title="Edit in the quiver editor"
            @onclick="() => OnEdit.InvokeAsync()">
        <i class="fa-solid fa-pencil"></i>
    </button>
</div>

@code {
    [Parameter, EditorRequired] public string Json { get; set; } = "";
    [Parameter] public int Height { get; set; } = 280;
    /// <summary>Raised by the hover pencil — switch to the editor view.</summary>
    [Parameter] public EventCallback OnEdit { get; set; }

    QuiverImport.ParseOutcome parsed = QuiverImport.TryParse("");
    string embedSrc = "";
    string? lastJson;

    protected override void OnParametersSet()
    {
        // OnParametersSet fires on every parent render (the EventCallback
        // parameter defeats Blazor's unchanged-parameter skip) — only re-parse
        // and re-point the iframe when the JSON actually changed
        if (Json == lastJson) return;
        lastJson = Json;
        parsed = QuiverImport.TryParse(Json ?? "");
        embedSrc = "";
        if (parsed.Ok && parsed.Graph.VertexCount > 0)
        {
            var t = (Json ?? "").Trim();
            var b64 = t.StartsWith("[") ? Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(t)) : t;
            // relative URL so it works whatever host address the webview uses;
            // pad shrinks quiver's embed margins so the diagram fills the box
            embedSrc = "_content/AbCatDC.RazorLib/quiver/index.html#q=" + b64 + "&embed&pad=10";
        }
    }
}
