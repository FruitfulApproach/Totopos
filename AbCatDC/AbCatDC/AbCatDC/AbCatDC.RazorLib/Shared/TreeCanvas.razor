@using AbCatDC.Kernel
@inject IJSRuntime JS
@implements IDisposable

@* A restricted proof-tree editor: statements and rule instances as nodes,
   conclusion → premise wires, colours by judgment class, cycles in red,
   drag with pointer capture, snap-to-grid, Ctrl+wheel zoom, and drops of
   rules from outside. The kernel ProofTree does the reasoning. *@
<div class="tc-root">
<div class="pt-canvas tc-canvas" id="@CanvasId" @onpointermove="OnMove" @onpointerup="OnUp" @onpointercancel="OnUp" @onpointerleave="OnLeave"
     @ondragover:preventDefault @ondrop="OnDrop" @ondrop:preventDefault>
    <div class="pt-surface @(Snap ? "tc-grid" : "")" id="@SurfaceId" style="width:@(Px(SurfaceW)); height:@(Px(SurfaceH)); zoom:@(ZoomText); --tc-grid:@(Px(Grid))">
        <svg class="pt-wires" width="@SurfaceW" height="@SurfaceH">
            @foreach (var w in Tree.Wires)
            {
                var a = PortPos(w.Src, w.SrcIdx, false);
                var b = PortPos(w.Dst, w.DstIdx, true);
                if (a is null || b is null) { continue; }
                var cls = "pt-wire" + (report.CycleWires.Contains(w.Id) ? " cycle" : "") + (badWires.ContainsKey(w.Id) ? " bad" : "") + (selectedWire == w.Id ? " sel" : "");
                <path d="@Bezier(a.Value, b.Value)" class="@cls" @onclick="() => selectedWire = w.Id" @onclick:stopPropagation>
                    @if (badWires.TryGetValue(w.Id, out var why)) { <title>@why</title> }
                </path>
                @if (selectedWire == w.Id)
                {
                    var mx = (a.Value.x + b.Value.x) / 2;
                    var my = (a.Value.y + b.Value.y) / 2;
                    <g class="pt-wire-del" @onclick="() => RemoveWire(w.Id)" @onclick:stopPropagation>
                        <circle cx="@mx" cy="@my" r="9" />
                        <text x="@mx" y="@(my + 4)" text-anchor="middle">×</text>
                    </g>
                }
            }
            @if (pendingSrc is not null)
            {
                <path d="@Bezier((pendingStartX, pendingStartY), (pendingX, pendingY))" class="pt-wire pending" />
            }
        </svg>
        @foreach (var n in Tree.Nodes)
        {
            var onCycle = report.CycleNodes.Contains(n.Id);
            var proven = provenNodes.Contains(n.Id);
            var nodeCls = "pt-node " + (n.IsRule ? "rule" : "stmt " + n.Role) + (onCycle ? " cycle" : "") + (n.Error is not null ? " broken" : "") + (proven ? " proven" : "") + (freshNode == n.Id ? " fresh" : "");
            <div class="@nodeCls" id="@NodeId(n.Id)" data-node="@n.Id" style="left:@(Px(n.X)); top:@(Px(n.Y))" @key="n.Id"
                 @onpointerdown="e => StartDrag(n, e)" @ondblclick="OnNodeDblClick">
                @if (!n.IsRule)
                {
                    var sj = Judgment(n.Id, 0, false);
                    var sEst = establishedPorts.Contains((n.Id, 0));
                    var sWired = wiredPremises.Contains((n.Id, 0));
                    <div class="pt-ports single">
                        <div class="pt-chip stmtchip @(sEst ? "est" : "") @(sWired ? "wired" : "")" style="@ChipStyle(sj)"
                             title="@(n.Role == "given" ? "a given — established by assumption" : "drop a conclusion on the top dot to establish this; drag the bottom dot to use it")"
                             @onpointerup="() => EndWire(n.Id, 0)" @onpointerup:stopPropagation>
                            <span class="pt-dot in" data-port="@($"{n.Id}:p:0")"></span>
                            @if (sEst) { <i class="fa-solid fa-check pt-est-mark"></i> }
                            <InlineExpr Text="@(sj?.Text ?? n.Conclusions[0])" Sketches="Sketches" Snapshots="Snapshots" Height="56" OnOpen="OnOpenSketch" OnSnapshot="OnSnapshot" />
                            @if (HasFacts(sj?.Text ?? n.Conclusions[0]))
                            {
                                <button type="button" class="tc-unfold" title="unfold what this picture says into nodes you can wire from"
                                        @onclick="() => OpenUnfold(n.Id, 0)" @onclick:stopPropagation @onpointerdown:stopPropagation @onpointerup:stopPropagation><i class="fa-solid fa-list-ul"></i></button>
                            }
                            <span class="pt-dot out" data-port="@($"{n.Id}:c:0")" title="drag onto a premise to wire"
                                  @onpointerdown="e => StartWire(n.Id, 0, e)" @onpointerdown:stopPropagation @onpointerdown:preventDefault></span>
                        </div>
                    </div>
                }
                <div class="pt-ports top @(n.IsRule ? "" : "none")">
                    @for (var i = 0; n.IsRule && i < n.Premises.Count; i++)
                    {
                        var idx = i;
                        var j = Judgment(n.Id, idx, true);
                        var discharged = wiredPremises.Contains((n.Id, idx));
                        <div class="pt-chip prem @(j is { Ground: false } ? "open" : "") @(discharged ? "wired" : "")" style="@ChipStyle(j)"
                             data-port="@($"{n.Id}:p:{idx}")" title="premise @(idx + 1) — drop a conclusion here"
                             @onpointerup="() => EndWire(n.Id, idx)" @onpointerup:stopPropagation>
                            <span class="pt-dot in"></span><InlineExpr Text="@(j?.Text ?? n.Premises[idx])" Sketches="Sketches" Snapshots="Snapshots" Height="56" OnOpen="OnOpenSketch" OnSnapshot="OnSnapshot" />
                        </div>
                    }
                    @if (n.IsRule && n.Premises.Count == 0) { <span class="pt-nopremise">(no premises)</span> }
                </div>
                <div class="pt-bar">
                    <span class="pt-id">#@n.Id</span>
                    @if (n.IsRule)
                    {
                        <span class="pt-name">@n.RuleName</span>
                        <span class="pt-kind">@n.RuleKind</span>
                        @if (OnEditRule.HasDelegate)
                        {
                            <button type="button" class="pt-x tc-pencil" title="edit this rule in the rule editor" @onclick="() => OnEditRule.InvokeAsync(n.RuleName)" @onpointerdown:stopPropagation><i class="fa-solid fa-pencil"></i></button>
                        }
                    }
                    else
                    {
                        <span class="pt-role-btn @n.Role"><i class="fa-solid @RoleIcon(n.Role)"></i> @n.Role</span>
                        @if (proven) { <span class="pt-proven-badge" title="established"><i class="fa-solid fa-check"></i></span> }
                    }
                    @if (n.IsRule || n.Role == "lemma")
                    {
                        <button type="button" class="pt-x" title="remove" @onclick="() => RemoveNode(n.Id)" @onpointerdown:stopPropagation>×</button>
                    }
                </div>
                @if (n.Error is not null) { <div class="pt-broken">@n.Error</div> }
                <div class="pt-ports bottom @(n.IsRule ? "" : "none")">
                    @for (var i = 0; n.IsRule && i < n.Conclusions.Count; i++)
                    {
                        var idx = i;
                        var j = Judgment(n.Id, idx, false);
                        var est = establishedPorts.Contains((n.Id, idx));
                        <div class="pt-chip concl @(j is { Ground: false } ? "open" : "") @(est ? "est" : "")" style="@ChipStyle(j)"
                             data-port="@($"{n.Id}:c:{idx}")" title="@(est ? "established — drag the dot to use it" : $"conclusion {idx + 1} — established once every premise is discharged")">
                            @if (est) { <i class="fa-solid fa-check pt-est-mark"></i> }
                            <InlineExpr Text="@(j?.Text ?? n.Conclusions[idx])" Sketches="Sketches" Snapshots="Snapshots" Height="56" OnOpen="OnOpenSketch" OnSnapshot="OnSnapshot" />
                            @if (est && HasFacts(j?.Text ?? n.Conclusions[idx]))
                            {
                                <button type="button" class="tc-unfold" title="unfold what this picture says into nodes you can wire from"
                                        @onclick="() => OpenUnfold(n.Id, idx)" @onclick:stopPropagation @onpointerdown:stopPropagation @onpointerup:stopPropagation><i class="fa-solid fa-list-ul"></i></button>
                            }
                            <span class="pt-dot out" title="drag onto a premise to wire"
                                 @onpointerdown="e => StartWire(n.Id, idx, e)" @onpointerdown:stopPropagation @onpointerdown:preventDefault></span>
                        </div>
                    }
                </div>
                @if (unfoldPort is { } up && up.node == n.Id)
                {
                    <div class="tc-unfold-panel" @onpointerdown:stopPropagation @ondblclick:stopPropagation>
                        <div class="tc-unfold-head">
                            <span><i class="fa-solid fa-list-ul"></i> this picture says</span>
                            <button type="button" class="ab-link-btn" @onclick="SelectAllFacts">all</button>
                            <button type="button" class="ab-link-btn" @onclick="() => unfoldSel.Clear()">none</button>
                            <button type="button" class="pt-x" @onclick="() => unfoldPort = null">×</button>
                        </div>
                        <div class="tc-unfold-list">
                            @for (var f = 0; f < unfoldFacts.Length; f++)
                            {
                                var fi = f;
                                <label class="tc-unfold-item">
                                    <input type="checkbox" checked="@unfoldSel.Contains(fi)" @onchange="e => ToggleFact(fi, e)" />
                                    <span>@unfoldFacts[fi]</span>
                                </label>
                            }
                        </div>
                        <button type="button" class="ab-btn-primary sm" disabled="@(unfoldSel.Count == 0)" @onclick="AddUnfolded">
                            <i class="fa-solid fa-plus"></i> add @unfoldSel.Count as node@(unfoldSel.Count == 1 ? "" : "s")
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>
<div class="tc-zoom" @onpointerdown:stopPropagation>
    <button type="button" class="ab-kind-btn" @onclick="() => SetZoomFromUi(zoom / 1.1)" title="zoom out (Ctrl + wheel)"><i class="fa-solid fa-magnifying-glass-minus"></i></button>
    <button type="button" class="ab-kind-btn" @onclick="() => SetZoomFromUi(1)" title="reset zoom (Ctrl + wheel zooms about the cursor)">@((int)Math.Round(zoom * 100))%</button>
    <button type="button" class="ab-kind-btn" @onclick="() => SetZoomFromUi(zoom * 1.1)" title="zoom in (Ctrl + wheel)"><i class="fa-solid fa-magnifying-glass-plus"></i></button>
</div>
</div>

@code {
    [Parameter, EditorRequired] public TreeDto Tree { get; set; } = new();
    [Parameter] public IReadOnlyDictionary<string, string>? Sketches { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string>? Snapshots { get; set; }
    /// <summary>snap node positions to the grid</summary>
    [Parameter] public bool Snap { get; set; } = true;
    /// <summary>grid pitch in canvas units (pixels at 100%)</summary>
    [Parameter] public double Grid { get; set; } = 20;
    [Parameter] public string CanvasId { get; set; } = "tc-canvas";
    /// <summary>after any change to the tree (nodes, wires, positions) — the owner persists it</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>something dropped on the canvas, in canvas units</summary>
    [Parameter] public EventCallback<(double x, double y)> OnDropAt { get; set; }
    [Parameter] public EventCallback<string> OnOpenSketch { get; set; }
    [Parameter] public EventCallback<string> OnSnapshot { get; set; }
    [Parameter] public EventCallback<string> OnEditRule { get; set; }
    [Parameter] public EventCallback<string> OnMessage { get; set; }

    string SurfaceId => CanvasId + "-surface";
    string NodeId(int id) => CanvasId + "-node-" + id;

    class PortMeasure { public string Key { get; set; } = ""; public double X { get; set; } public double Top { get; set; } public double Bottom { get; set; } }
    class NodeRect { public int Id { get; set; } public double W { get; set; } public double H { get; set; } }
    class CanvasRect { public double Left { get; set; } public double Top { get; set; } public double Sl { get; set; } public double St { get; set; } }

    const string CanvasJs = @"window.abTC = window.abTC || { measure: function (id, k) {
        var s = document.getElementById(id); if (!s) return []; k = k || 1;
        var r = s.getBoundingClientRect(); var out = [];
        s.querySelectorAll('[data-port]').forEach(function (el) { var b = el.getBoundingClientRect();
            out.push({ key: el.getAttribute('data-port'), x: (b.left + b.width / 2 - r.left) / k, top: (b.top - r.top) / k, bottom: (b.bottom - r.top) / k }); });
        return out; },
      nodes: function (id, k) {
        var s = document.getElementById(id); if (!s) return []; k = k || 1; var out = [];
        s.querySelectorAll('[data-node]').forEach(function (el) { var b = el.getBoundingClientRect(); out.push({ id: parseInt(el.getAttribute('data-node')), w: b.width / k, h: b.height / k }); });
        return out; },
      rect: function (id) { var c = document.getElementById(id); if (!c) return null; var r = c.getBoundingClientRect(); return { left: r.left, top: r.top, sl: c.scrollLeft, st: c.scrollTop }; },
      wheelZoom: function (canvasId, surfaceId, ref) {
        var c = document.getElementById(canvasId); if (!c || c.__abZoom) return; c.__abZoom = true;
        c.addEventListener('wheel', function (e) {
            if (!e.ctrlKey) return; e.preventDefault();
            var s = document.getElementById(surfaceId); if (!s) return;
            var k = parseFloat(s.style.zoom || '1') || 1;
            var k2 = Math.min(3, Math.max(0.25, k * (e.deltaY < 0 ? 1.1 : 1 / 1.1)));
            var cr = c.getBoundingClientRect();
            var px = (c.scrollLeft + e.clientX - cr.left) / k, py = (c.scrollTop + e.clientY - cr.top) / k;
            s.style.zoom = k2; c.scrollLeft = px * k2 - (e.clientX - cr.left); c.scrollTop = py * k2 - (e.clientY - cr.top);
            ref.invokeMethodAsync('SetZoom', k2);
        }, { passive: false }); },
      setZoom: function (canvasId, surfaceId, k2) {
        var c = document.getElementById(canvasId); var s = document.getElementById(surfaceId); if (!c || !s) return;
        var k = parseFloat(s.style.zoom || '1') || 1; var cr = c.getBoundingClientRect();
        var px = (c.scrollLeft + cr.width / 2) / k, py = (c.scrollTop + cr.height / 2) / k;
        s.style.zoom = k2; c.scrollLeft = px * k2 - cr.width / 2; c.scrollTop = py * k2 - cr.height / 2; },
      sketchAt: function (x, y) { var el = document.elementFromPoint(x, y); var w = el && el.closest ? el.closest('[data-sketch]') : null; return w ? w.getAttribute('data-sketch') : ''; },
      capture: function (id, pid) { var el = document.getElementById(id); if (el && el.setPointerCapture) { try { el.setPointerCapture(pid); } catch (e) { } } } };";

    // ---- kernel state ------------------------------------------------------------
    ProofTree tree = new();
    TreeReport report = EmptyReport();
    Dictionary<(int, int, bool), TreeJudgment> jmap = new();
    Dictionary<int, string> badWires = new();
    HashSet<(int, int)> establishedPorts = new();
    HashSet<(int, int)> wiredPremises = new();
    HashSet<int> provenNodes = new();
    readonly Dictionary<string, PortMeasure> ports = new();
    readonly Dictionary<int, NodeRect> rects = new();
    bool needMeasure, jsReady;
    int? selectedWire;
    int freshNode = -1;
    double zoom = 1;
    string ZoomText => zoom.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    DotNetObjectReference<TreeCanvas>? selfRef;
    TreeDto? boundTree;

    public TreeReport Report => report;
    public bool IsProven(int nodeId) => provenNodes.Contains(nodeId);
    /// <summary>every established conclusion port: (text, node, index) — what a rule may consume</summary>
    public List<(string Text, int Node, int Index)> Facts() =>
        report.Judgments.Where(j => !j.IsPremise && establishedPorts.Contains((j.Node, j.Index))).Select(j => (j.Text, j.Node, j.Index)).ToList();
    public string? JudgmentText(int node, int idx, bool premise) => Judgment(node, idx, premise)?.Text;

    static TreeReport EmptyReport() =>
        new(Array.Empty<TreeJudgment>(), Array.Empty<TreeBinding>(), Array.Empty<TreePort>(), Array.Empty<TreePort>(),
            Array.Empty<TreePort>(), Array.Empty<TreePort>(), Array.Empty<int>(), Array.Empty<int>(), Array.Empty<TreeWireIssue>(), 0);

    double SurfaceW => Math.Max(1400, Tree.Nodes.Count == 0 ? 0 : Tree.Nodes.Max(n => n.X) + 700);
    double SurfaceH => Math.Max(700, Tree.Nodes.Count == 0 ? 0 : Tree.Nodes.Max(n => n.Y) + 400);
    static string Px(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "px";

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(boundTree, Tree)) { boundTree = Tree; Rebuild(); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("eval", CanvasJs); } catch { }
            selfRef = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("abTC.wheelZoom", CanvasId, SurfaceId, selfRef); } catch { }
            jsReady = true;
            needMeasure = true;
        }
        if (!needMeasure || !jsReady) return;
        needMeasure = false;
        PortMeasure[] measured; NodeRect[] sizes;
        try
        {
            measured = await JS.InvokeAsync<PortMeasure[]>("abTC.measure", SurfaceId, zoom);
            sizes = await JS.InvokeAsync<NodeRect[]>("abTC.nodes", SurfaceId, zoom);
        }
        catch { return; }
        var changed = false;
        foreach (var m in measured)
            if (!ports.TryGetValue(m.Key, out var old) || Math.Abs(old.X - m.X) > 0.5 || Math.Abs(old.Top - m.Top) > 0.5 || Math.Abs(old.Bottom - m.Bottom) > 0.5) { ports[m.Key] = m; changed = true; }
        foreach (var r in sizes)
            if (!rects.TryGetValue(r.Id, out var old) || Math.Abs(old.W - r.W) > 0.5 || Math.Abs(old.H - r.H) > 0.5) { rects[r.Id] = r; changed = true; }
        if (changed) StateHasChanged();
    }

    /// <summary>Replay the DTO into a fresh kernel tree.</summary>
    public void Rebuild()
    {
        tree = new ProofTree();
        foreach (var n in Tree.Nodes)
        {
            n.Error = null;
            var e = n.IsRule ? tree.AddRule(n.Id, n.Premises.ToArray(), n.Conclusions.ToArray()) : tree.AddStatement(n.Id, n.Conclusions.FirstOrDefault() ?? "", n.Role == "given");
            if (e.Length > 0) n.Error = e;
        }
        foreach (var w in Tree.Wires.OrderBy(w => w.Id)) tree.Connect(w.Id, w.Src, w.SrcIdx, w.Dst, w.DstIdx);
        Refresh();
    }

    void Refresh()
    {
        report = tree.Report();
        jmap = report.Judgments.ToDictionary(j => (j.Node, j.Index, j.IsPremise), j => j);
        badWires = report.BadWires.GroupBy(b => b.Wire).ToDictionary(g => g.Key, g => g.First().Message);
        establishedPorts = report.Established.Select(p => (p.Node, p.Index)).ToHashSet();
        provenNodes = report.Proven.Select(p => p.Node).ToHashSet();
        wiredPremises = Tree.Wires.Select(w => (w.Dst, w.DstIdx)).ToHashSet();
        needMeasure = true;
    }

    async Task Changed() { Refresh(); await OnChanged.InvokeAsync(); StateHasChanged(); }

    // ---- public editing API (the owner drives rule application) ---------------------
    double SnapV(double v) => Snap && Grid > 0 ? Math.Round(v / Grid) * Grid : v;

    /// <summary>Place a rule instance; returns its id, or -1 with the parse error reported.</summary>
    public async Task<int> AddRuleNode(RuleDto r, double x, double y)
    {
        var n = new TreeNodeDto
        {
            Id = Tree.NextId++, IsRule = true, Role = "rule",
            RuleName = string.IsNullOrWhiteSpace(r.Name) ? $"{r.Kind} rule" : r.Name, RuleKind = r.Kind,
            Premises = r.Premises.ToList(), Conclusions = r.Conclusions.ToList(), X = SnapV(Math.Max(0, x)), Y = SnapV(Math.Max(0, y))
        };
        var e = tree.AddRule(n.Id, n.Premises.ToArray(), n.Conclusions.ToArray());
        if (e.Length > 0) { await OnMessage.InvokeAsync($"{n.RuleName}: {e}"); return -1; }
        Tree.Nodes.Add(n);
        freshNode = n.Id;
        await Changed();
        return n.Id;
    }

    /// <summary>Wire a conclusion port into a premise; "" or the reason it does not fit (the wire is then not kept).</summary>
    public async Task<string> Wire(int src, int srcIdx, int dst, int dstIdx, bool silent = false)
    {
        var id = Tree.NextId;
        var msg = tree.Connect(id, src, srcIdx, dst, dstIdx);
        if (msg.Length > 0) { Rebuild(); if (!silent) await OnMessage.InvokeAsync("cannot wire: " + msg); return msg; }
        Tree.NextId++;
        Tree.Wires.RemoveAll(w => w.Dst == dst && w.DstIdx == dstIdx);
        Tree.Wires.Add(new TreeWireDto { Id = id, Src = src, SrcIdx = srcIdx, Dst = dst, DstIdx = dstIdx });
        await Changed();
        return "";
    }

    public (double w, double h) SizeOf(int id) => rects.TryGetValue(id, out var r) ? (r.W, r.H) : (260, 120);

    async Task RemoveWire(int id)
    {
        tree.Disconnect(id);
        Tree.Wires.RemoveAll(w => w.Id == id);
        if (selectedWire == id) selectedWire = null;
        await Changed();
    }

    public async Task RemoveNode(int id)
    {
        tree.Remove(id);
        Tree.Nodes.RemoveAll(n => n.Id == id);
        Tree.Wires.RemoveAll(w => w.Src == id || w.Dst == id);
        if (selectedWire is int s && Tree.Wires.All(w => w.Id != s)) selectedWire = null;
        await Changed();
    }

    // ---- drops from outside ------------------------------------------------------------
    async Task OnDrop(DragEventArgs e)
    {
        CanvasRect? r = null;
        try { r = await JS.InvokeAsync<CanvasRect?>("abTC.rect", CanvasId); } catch { }
        if (r is null) return;
        var x = (e.ClientX - r.Left + r.Sl) / zoom;
        var y = (e.ClientY - r.Top + r.St) / zoom;
        await OnDropAt.InvokeAsync((SnapV(x), SnapV(y)));
    }

    // ---- zoom --------------------------------------------------------------------------
    [JSInvokable] public void SetZoom(double k) { zoom = Math.Clamp(k, 0.25, 3); needMeasure = true; StateHasChanged(); }
    async Task SetZoomFromUi(double k)
    {
        zoom = Math.Clamp(k, 0.25, 3);
        try { await JS.InvokeVoidAsync("abTC.setZoom", CanvasId, SurfaceId, zoom); } catch { }
        needMeasure = true;
    }

    // ---- pointer: node drag (capture after a real move), wire drawing ------------------
    TreeNodeDto? dragNode;
    bool dragCaptured;
    double lastX, lastY, pressX, pressY;
    int pressSerial;
    (int node, int idx)? pendingSrc;
    double pendingStartX, pendingStartY, pendingX, pendingY, pendingClientX, pendingClientY;

    void StartDrag(TreeNodeDto n, PointerEventArgs e)
    {
        if (pendingSrc is not null) return;
        dragNode = n; dragCaptured = false; pressSerial++;
        pressX = lastX = e.ClientX; pressY = lastY = e.ClientY;
    }

    async Task OnMove(PointerEventArgs e)
    {
        if (dragNode is not null)
        {
            var dx = (e.ClientX - lastX) / zoom;
            var dy = (e.ClientY - lastY) / zoom;
            if (!dragCaptured && Math.Max(Math.Abs(e.ClientX - pressX), Math.Abs(e.ClientY - pressY)) < 6) return;
            if (!dragCaptured)
            {
                dragCaptured = true;
                var serial = pressSerial; var id = dragNode.Id;
                try { await JS.InvokeVoidAsync("abTC.capture", NodeId(id), e.PointerId); } catch { }
                if (serial != pressSerial || dragNode is null) return;
            }
            dragNode.X = Math.Max(0, dragNode.X + dx);
            dragNode.Y = Math.Max(0, dragNode.Y + dy);
            lastX = e.ClientX; lastY = e.ClientY;
            needMeasure = true;
        }
        else if (pendingSrc is not null)
        {
            pendingX = pendingStartX + (e.ClientX - pendingClientX) / zoom;
            pendingY = pendingStartY + (e.ClientY - pendingClientY) / zoom;
        }
    }

    async Task OnUp()
    {
        var moved = dragNode is not null && dragCaptured;
        if (moved && dragNode is not null) { dragNode.X = SnapV(dragNode.X); dragNode.Y = SnapV(dragNode.Y); }
        dragNode = null; dragCaptured = false; pendingSrc = null;
        if (moved) { needMeasure = true; await OnChanged.InvokeAsync(); }
    }

    void OnLeave() { if (dragNode is null) pendingSrc = null; }

    void StartWire(int node, int idx, PointerEventArgs e)
    {
        dragNode = null;
        var p = PortPos(node, idx, false);
        if (p is null) return;
        pendingSrc = (node, idx);
        pendingStartX = pendingX = p.Value.x; pendingStartY = pendingY = p.Value.y;
        pendingClientX = e.ClientX; pendingClientY = e.ClientY;
    }

    async Task EndWire(int node, int idx)
    {
        if (pendingSrc is null) { await OnUp(); return; }
        var src = pendingSrc.Value;
        pendingSrc = null;
        selectedWire = null;
        await Wire(src.node, src.idx, node, idx);
    }

    async Task OnNodeDblClick(MouseEventArgs e)
    {
        string name = "";
        try { name = await JS.InvokeAsync<string>("abTC.sketchAt", e.ClientX, e.ClientY); } catch { }
        if (!string.IsNullOrEmpty(name)) await OnOpenSketch.InvokeAsync(name);
    }

    // ---- unfolding a picture's judgments into nodes -------------------------------------------
    (int node, int idx)? unfoldPort;
    string[] unfoldFacts = Array.Empty<string>();
    HashSet<int> unfoldSel = new();
    readonly Dictionary<string, bool> factsCache = new();

    bool HasFacts(string text)
    {
        if (!text.Contains('[')) return false;
        if (!factsCache.TryGetValue(text, out var has)) { has = Api.DerivedFacts(text).Length > 0; factsCache[text] = has; }
        return has;
    }

    void SelectAllFacts() => unfoldSel = Enumerable.Range(0, unfoldFacts.Length).ToHashSet();
    void ToggleFact(int fi, ChangeEventArgs e) { if (e.Value is bool b && b) unfoldSel.Add(fi); else unfoldSel.Remove(fi); }

    void OpenUnfold(int node, int idx)
    {
        var text = Judgment(node, idx, false)?.Text ?? "";
        var all = Api.DerivedFacts(text);
        // what the tree already states is left out
        var have = report.Judgments.Where(j => !j.IsPremise).Select(j => j.Text).ToList();
        unfoldFacts = all.Where(f => !have.Any(h => Api.SameExpr(h, f))).ToArray();
        unfoldSel = unfoldFacts.Length <= 8 ? Enumerable.Range(0, unfoldFacts.Length).ToHashSet() : new HashSet<int>();
        unfoldPort = unfoldFacts.Length == 0 ? null : (node, idx);
        if (unfoldFacts.Length == 0) _ = OnMessage.InvokeAsync("everything this picture says is already on the canvas");
    }

    /// <summary>Selected facts become lemma nodes below the picture, each wired from it (the wire holds because the
    /// picture supplies the fact), so they are established and can feed rules.</summary>
    async Task AddUnfolded()
    {
        if (unfoldPort is not { } up) return;
        var src = Tree.Nodes.FirstOrDefault(n => n.Id == up.node);
        if (src is null) return;
        var (w, h) = SizeOf(src.Id);
        var k = 0;
        foreach (var fi in unfoldSel.OrderBy(i => i))
        {
            if (fi >= unfoldFacts.Length) continue;
            var text = unfoldFacts[fi];
            var n = new TreeNodeDto { Id = Tree.NextId++, Role = "lemma", Premises = new() { text }, Conclusions = new() { text }, X = SnapV(src.X + k * 300), Y = SnapV(src.Y + h + 90) };
            var e = tree.AddStatement(n.Id, text, false);
            if (e.Length > 0) continue;
            Tree.Nodes.Add(n);
            var wid = Tree.NextId++;
            tree.Connect(wid, up.node, up.idx, n.Id, 0);
            Tree.Wires.Add(new TreeWireDto { Id = wid, Src = up.node, SrcIdx = up.idx, Dst = n.Id, DstIdx = 0 });
            k++;
        }
        unfoldPort = null;
        await Changed();
    }

    // ---- geometry & colour ---------------------------------------------------------------
    (double x, double y)? PortPos(int node, int idx, bool premise) =>
        ports.TryGetValue($"{node}:{(premise ? "p" : "c")}:{idx}", out var m) ? (m.X, premise ? m.Top : m.Bottom) : null;

    static string Bezier((double x, double y) a, (double x, double y) b)
    {
        var d = Math.Clamp(Math.Abs(b.y - a.y) / 2, 40, 160);
        return string.Format(System.Globalization.CultureInfo.InvariantCulture, "M {0:0.#} {1:0.#} C {0:0.#} {2:0.#}, {3:0.#} {4:0.#}, {3:0.#} {5:0.#}", a.x, a.y, a.y + d, b.x, b.y - d, b.y);
    }

    TreeJudgment? Judgment(int node, int idx, bool premise) => jmap.TryGetValue((node, idx, premise), out var j) ? j : null;
    static double Hue(int c) => (c * 137.508) % 360;
    static string ChipStyle(TreeJudgment? j)
    {
        if (j is null) return "";
        var h = Hue(j.Class).ToString("0", System.Globalization.CultureInfo.InvariantCulture);
        return $"background: hsl({h} 70% 88%); border-color: hsl({h} 55% 45%); color: #1c1e26";
    }
    static string RoleIcon(string role) => role switch { "given" => "fa-leaf", "goal" => "fa-flag-checkered", _ => "fa-bookmark" };

    public void Dispose() => selfRef?.Dispose();
}
